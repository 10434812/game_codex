/* ============================================
   Design Tokens — 东方纸张主题色系
   主色: 橘黄  辅色: 暖金棕  背景: 米纸黄
   ============================================ */
page {
  /* 背景 */
  --bg-base: #f6ebd1;
  --bg-card: rgba(255, 251, 241, 0.9);
  --bg-panel: rgba(255, 248, 234, 0.93);

  /* 主色 · 橘黄 */
  --red-primary: #e57c1f;
  --red-bright:  #f4b24a;
  --red-deep:    #c96a10;
  --red-ink:     #5d3615;

  /* 辅色 · 暖金棕 */
  --gold-warm:   #d2a45a;
  --gold-mid:    #9e743e;
  --gold-dark:   #6b4a2d;
  --brown-text:  #4a2d1a;
  --brown-sub:   #8a7051;

  /* 边框 */
  --border-warm: rgba(205, 171, 114, 0.6);
  --border-gold: rgba(221, 198, 154, 0.75);

  /* 头像外框，可统一调整边框、留白和颜色 */
  --avatar-ring-padding: 5rpx;
  --avatar-ring-border: 4rpx;
  --avatar-ring-border-color: #9a6e3a;
  --avatar-ring-bg-start: #ffd45f;
  --avatar-ring-bg-end: #f1a91f;
  --avatar-ring-shadow: 0 8rpx 18rpx rgba(145, 98, 27, 0.22);

  background: #f6ebd1;
  color: #51331c;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.paper-bg {
  min-height: 100vh;
  background: transparent;
  position: relative;
  z-index: 0;
}

.global-bg-image {
  position: absolute !important;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -1 !important;
  opacity: 1;
}

.app-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 8rpx;
  padding-bottom: 14rpx;
  min-height: 88rpx;
  margin-bottom: 6rpx;
  animation: header-enter 0.46s ease-out both;
}

.app-user {
  display: flex;
  align-items: center;
  min-width: 0;
}

.app-user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--stage-border, rgba(200, 143, 101, 0.9));
  background: linear-gradient(145deg, var(--stage-bright, #efc49a), var(--stage-primary, #d88e66));
  box-shadow: 0 4rpx 12rpx var(--stage-glow, rgba(128, 85, 51, 0.2));
  flex-shrink: 0;
}

.app-user-name {
  margin-left: 12rpx;
  color: var(--stage-bright, #9e743e);
  font-size: 44rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 4rpx 14rpx var(--stage-shadow, rgba(48, 27, 11, 0.22));
}

.app-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.app-status-pill {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 248, 232, 0.74);
  border: 0;
  box-shadow: 0 10rpx 24rpx rgba(16, 18, 25, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(34rpx) saturate(1.08);
  backdrop-filter: blur(34rpx) saturate(1.08);
}

.app-status-dot {
  font-size: 18rpx;
  color: #2bbf9f;
  margin-right: 8rpx;
  animation: status-breathe 1.6s ease-in-out infinite;
}

.app-status-text {
  color: var(--stage-deep, #9a7643);
  font-size: 28rpx;
  font-weight: 600;
}

.app-gear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--stage-deep, #ab7b41);
  background: rgba(255, 248, 232, 0.7);
  border: 0;
  box-shadow: 0 10rpx 24rpx rgba(16, 18, 25, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.46);
  -webkit-backdrop-filter: blur(34rpx) saturate(1.08);
  backdrop-filter: blur(34rpx) saturate(1.08);
}

.page-content {
  position: relative;
  z-index: 1;
  animation: page-rise-in 0.54s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.scene-backdrop {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.scene-backdrop-image,
.scene-backdrop-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.scene-backdrop-image {
  transform: scale(1.06);
  filter: blur(10rpx);
}

.scene-backdrop-video {
  opacity: 0.92;
}

.scene-backdrop-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(8, 14, 28, 0.08) 0%, rgba(8, 16, 28, 0.28) 42%, rgba(21, 18, 13, 0.36) 100%);
}

.scene-template {
  position: absolute;
  inset: 0;
  opacity: 0.62;
  background:
    radial-gradient(circle at 50% 18%, var(--stage-glow, rgba(245, 188, 96, 0.28)) 0%, transparent 26%),
    linear-gradient(135deg, transparent 0%, transparent 46%, var(--stage-wash, rgba(245, 188, 96, 0.16)) 46%, var(--stage-wash, rgba(245, 188, 96, 0.16)) 47%, transparent 47%, transparent 100%);
  background-size: auto, 180rpx 180rpx;
}

.scene-theme-fuji .scene-template {
  background:
    radial-gradient(circle at 72% 14%, var(--stage-glow, rgba(255, 190, 214, 0.3)) 0%, transparent 24%),
    radial-gradient(ellipse at 24% 30%, var(--stage-wash, rgba(255, 188, 215, 0.18)) 0%, transparent 30%),
    linear-gradient(150deg, transparent 0%, transparent 48%, var(--stage-wash, rgba(255, 188, 215, 0.16)) 48%, var(--stage-wash, rgba(255, 188, 215, 0.16)) 49%, transparent 49%, transparent 100%);
  background-size: auto, auto, 140rpx 180rpx;
}

.scene-theme-paris .scene-template {
  background:
    radial-gradient(circle at 50% 18%, var(--stage-glow, rgba(241, 197, 111, 0.28)) 0%, transparent 26%),
    linear-gradient(90deg, transparent 0%, transparent 48%, var(--stage-wash, rgba(241, 197, 111, 0.16)) 48%, var(--stage-wash, rgba(241, 197, 111, 0.16)) 50%, transparent 50%, transparent 100%),
    linear-gradient(25deg, transparent 0%, transparent 48%, var(--stage-wash, rgba(241, 197, 111, 0.12)) 48%, var(--stage-wash, rgba(241, 197, 111, 0.12)) 49%, transparent 49%, transparent 100%);
  background-size: auto, 120rpx 100%, 170rpx 170rpx;
}

.scene-theme-taj-mahal .scene-template {
  background:
    radial-gradient(ellipse at 50% 20%, var(--stage-glow, rgba(235, 214, 176, 0.32)) 0%, transparent 28%),
    radial-gradient(ellipse at 50% 48%, var(--stage-wash, rgba(214, 187, 141, 0.18)) 0%, transparent 34%),
    linear-gradient(90deg, transparent 0%, transparent 48%, var(--stage-wash, rgba(214, 187, 141, 0.12)) 48%, var(--stage-wash, rgba(214, 187, 141, 0.12)) 50%, transparent 50%, transparent 100%);
  background-size: auto, auto, 180rpx 100%;
}

.scene-theme-xihu .scene-template,
.scene-theme-gulangyu .scene-template {
  background:
    radial-gradient(circle at 30% 18%, var(--stage-glow, rgba(115, 214, 194, 0.26)) 0%, transparent 26%),
    linear-gradient(120deg, transparent 0%, transparent 44%, var(--stage-wash, rgba(115, 214, 194, 0.14)) 44%, var(--stage-wash, rgba(115, 214, 194, 0.14)) 46%, transparent 46%, transparent 100%),
    linear-gradient(60deg, transparent 0%, transparent 52%, var(--stage-wash, rgba(115, 214, 194, 0.12)) 52%, var(--stage-wash, rgba(115, 214, 194, 0.12)) 54%, transparent 54%, transparent 100%);
  background-size: auto, 180rpx 180rpx, 220rpx 220rpx;
}

.scene-layer {
  position: relative;
  z-index: 1;
}

.theme-page-backdrop {
  opacity: 0.72;
}

.theme-page-backdrop .scene-backdrop-image {
  transform: scale(1.08);
  filter: blur(16rpx) saturate(1.08);
  opacity: 0.44;
}

.theme-page-backdrop .scene-template {
  opacity: 0.52;
}

.theme-page-backdrop .scene-backdrop-mask {
  background:
    radial-gradient(circle at 50% 12%, var(--stage-glow, rgba(245, 188, 96, 0.24)) 0%, transparent 34%),
    linear-gradient(180deg, rgba(255, 250, 238, 0.72) 0%, var(--stage-panel, rgba(255, 248, 234, 0.7)) 48%, rgba(246, 235, 209, 0.92) 100%);
}

.card {
  background: var(--stage-panel, rgba(255, 251, 241, 0.9));
  border-radius: 30rpx;
  box-shadow: 0 10rpx 24rpx var(--stage-shadow, rgba(133, 98, 52, 0.12));
}

.primary-btn {
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--stage-bright, #f4b24a), var(--stage-primary, #e57c1f));
  color: #fff7e5;
  font-weight: 700;
}

.bottom-nav {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  background:
    radial-gradient(circle at 18% 12%, var(--stage-glow, rgba(245, 188, 96, 0.32)) 0%, transparent 34%),
    radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.56) 0%, transparent 38%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.62) 0%, var(--stage-panel, rgba(255, 248, 232, 0.58)) 44%, rgba(255, 246, 224, 0.42) 100%);
  border: 2rpx solid var(--stage-border, rgba(255, 238, 199, 0.5));
  border-radius: 38rpx;
  box-shadow:
    0 24rpx 54rpx rgba(6, 10, 18, 0.28),
    0 4rpx 12rpx var(--stage-glow, rgba(229, 124, 31, 0.16)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    inset 0 -1rpx 0 rgba(68, 42, 18, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx;
  min-height: 124rpx;
  overflow: hidden;
  -webkit-backdrop-filter: blur(46rpx) saturate(1.24) brightness(1.04);
  backdrop-filter: blur(46rpx) saturate(1.24) brightness(1.04);
  animation: nav-dock-in 0.52s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.bottom-nav::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 10rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.78), transparent);
  opacity: 0.86;
  pointer-events: none;
}

.bottom-nav::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  pointer-events: none;
}

.nav-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--stage-ink, #6d4b2a);
  font-size: 20rpx;
  line-height: 1.2;
  flex: 1;
  font-weight: 600;
  text-align: center;
}

.nav-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  margin-bottom: 6rpx;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.86) 0%, transparent 38%),
    linear-gradient(150deg, rgba(255, 246, 222, 0.78), var(--stage-chip, rgba(240, 213, 167, 0.62)));
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--stage-deep, #8a6438);
  font-size: 23rpx;
  line-height: 1;
  box-sizing: border-box;
  transform: translateY(0);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6), 0 8rpx 16rpx rgba(8, 12, 20, 0.12);
}

.nav-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.nav-item.active {
  color: var(--stage-primary, #d97a12);
  font-weight: 800;
}

.nav-item.active .nav-dot {
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.7) 0%, transparent 32%),
    linear-gradient(160deg, var(--stage-bright, #f5b95a), var(--stage-primary, #e57c1f));
  color: #fff5e5;
  border-color: rgba(255, 248, 229, 0.74);
  box-shadow:
    0 10rpx 22rpx var(--stage-glow, rgba(183, 102, 18, 0.34)),
    0 0 0 8rpx var(--stage-wash, rgba(245, 188, 96, 0.18)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.52);
  animation: nav-active-bob 1.8s ease-in-out infinite;
}

/* --- 全局游戏化交互动效 --- */
.btn-hover {
  transform: scale(0.94) !important;
  filter: brightness(0.9) !important;
  transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: inset 0 6rpx 12rpx rgba(0,0,0,0.15) !important;
}

.clickable-hover {
  opacity: 0.7;
  transform: scale(0.97);
  transition: all 0.1s ease;
}

@keyframes header-enter {
  from {
    opacity: 0;
    transform: translateY(-18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes page-rise-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes nav-dock-in {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes nav-active-bob {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-5rpx) scale(1.05);
  }
}

@keyframes status-breathe {
  0%, 100% {
    opacity: 0.64;
    transform: scale(0.92);
  }
  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}
