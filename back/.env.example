# ============================================================
# 锦鲤前程后端 环境变量示例
# 复制为 back/.env 并按实际环境填写（.env 已被 .gitignore 忽略，禁止提交）
# 所有密钥类变量（JWT_SECRET / ADMIN_JWT_SECRET / WX_SECRET / ADMIN_PASSWORD / DB_PASSWORD）
# 在 production 下必须设置为强随机值，禁止使用示例/占位值
# ============================================================

# ── 服务 ──────────────────────────────────────────────────
# 服务监听端口
PORT=3000
# 运行环境：development | production | test（其它取值启动即报错）
NODE_ENV=development

# ── 部署渠道（生产必读）──────────────────────────────────
# public：正式公开发行；当前发行门禁（服务类目/实名防沉迷/发行资质）未满足，生产会拒绝启动。
# trial：受邀体验；生产必须同时配置 TRIAL_USER_IDS，否则拒绝启动。未设置时代码默认为 public。
DEPLOYMENT_CHANNEL=trial
# trial 渠道允许登录的用户编号（users.id），逗号分隔的正整数，例如 1,2,3
TRIAL_USER_IDS=
# 允许跨域访问的前端来源，逗号分隔；生产留空即不发送 CORS 头（推荐）；开发留空为 *
CORS_ORIGIN=

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 生产环境必须改为强口令（docker-compose 同时使用该变量）
DB_PASSWORD=change-me-strong-db-password
DB_NAME=game_codex

# ── JWT ───────────────────────────────────────────────────
# 用户端 token 签名密钥：生产必须 ≥32 位随机串，禁止占位值
JWT_SECRET=change-me-64-char-random-user-jwt-secret
# 管理员端 token 签名密钥（与用户端分离）：生产必须 ≥32 位随机串
ADMIN_JWT_SECRET=change-me-64-char-random-admin-jwt-secret
# 用户 token 有效期
JWT_EXPIRES_IN=7d

# ── 微信小程序 ────────────────────────────────────────────
# 小程序 AppID（与 project.config.json 保持一致）
WX_APPID=wxd7f500f3f21f15dd
# 小程序 AppSecret（微信公众平台获取；已泄露请立即重置）
WX_SECRET=your-wechat-app-secret

# 内容安全复用以上 AppID/AppSecret 或管理后台微信登录配置；缺失/错误时拒绝发布资料
# 微信公众平台消息推送配置：JSON 数据格式、安全模式，URL填以下公网域名 + /api/user/content-safety/callback
# Token及EncodingAESKey必须与微信消息推送配置完全一致；不得填写生产密钥到模板
WX_CONTENT_SAFETY_TOKEN=
WX_CONTENT_SAFETY_AES_KEY=
# 后端公网HTTPS根地址（不可带路径），必须同时可访问审核下载及回调路径
WX_CONTENT_SAFETY_BASE_URL=
# 头像上传仅受理为待审；只有验签解密后的微信pass结果才发布。需执行009迁移。

# ── 管理后台初始管理员（仅 scripts/create-admin.js 使用）──────
ADMIN_USERNAME=admin
# 首次创建管理员时使用；创建成功后请轮换/废弃
ADMIN_PASSWORD=change-me-strong-admin-password

# ── 上传资源公网地址；生产环境建议填 https://你的域名 ────────
CDN_BASE_URL=

# ── 福袋现实数据抓取任务 ───────────────────────────────────
# 设置为 false 可只保留后台手动刷新
FORTUNE_REALITY_JOB_ENABLED=false
FORTUNE_REALITY_JOB_INTERVAL_MS=300000

# ── 大模型接口（OpenAI 兼容）。也可以在后台系统配置里填写 ────
OPENCODEGO_BASE_URL=
OPENCODEGO_API_KEY=
OPENCODEGO_MODEL=
# 服务商标识（默认 opencodego）与单次请求超时毫秒数（默认 15000）
OPENCODEGO_PROVIDER=
OPENCODEGO_TIMEOUT_MS=

# ── 反向代理信任策略 ──────────────────────────────────────
# 部署在 nginx/负载均衡之后时设为代理跳数（单层 nginx 填 1），
# 否则 req.ip 恒为代理地址，登录限速与审计日志会失真。直连部署留空。
TRUST_PROXY=

# Token refresh keeps the first issuance time; fresh WeChat login resets it.
JWT_MAX_SESSION_DAYS=30
# Maximum graceful drain time before closing remaining connections.
SHUTDOWN_DRAIN_SECONDS=150
