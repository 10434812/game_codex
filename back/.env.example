# 服务端口
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=game_codex_pass
DB_NAME=game_codex

# JWT
JWT_SECRET=change-this-to-random-secret-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=wx72a4b552a87b44cf
WX_SECRET=your-wechat-app-secret

# 管理员种子账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 上传资源公网地址；生产环境建议填 https://你的域名
CDN_BASE_URL=

# 福袋现实数据抓取任务
# 设置为 false 可只保留后台手动刷新
FORTUNE_REALITY_JOB_ENABLED=true
FORTUNE_REALITY_JOB_INTERVAL_MS=300000

# 大模型接口（OpenAI 兼容）。也可以在后台系统配置里填写。
OPENCODEGO_BASE_URL=
OPENCODEGO_API_KEY=
OPENCODEGO_MODEL=
