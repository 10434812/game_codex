<view class="paper-bg shop-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg.png" mode="scaleToFill"></image>

  <view class="app-header" style="padding-top: {{ nav.statusBarHeight }}px; padding-right: {{ nav.capsuleSpace }}px;">
    <view class="app-user">
      <image wx:if="{{avatarUrl}}" class="app-user-avatar shop-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <image wx:else class="app-user-avatar shop-avatar" src="{{defaultAvatar}}" mode="aspectFill"></image>
      <text class="app-user-name">装备商城</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-text">装备商城</text>
      </view>
      <view class="app-gear" bindtap="onBack" aria-label="返回" hover-class="clickable-hover">←</view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop theme-page-backdrop shop-scene-backdrop" wx:if="{{stageImage || stageVideo}}">
      <image wx:if="{{stageImage}}" class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <video
        wx:if="{{stageVideo}}"
        id="scene-backdrop-video"
        class="scene-backdrop-video"
        src="{{stageVideo}}"
        poster="{{stageImage}}"
        autoplay
        muted
        loop
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        show-fullscreen-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        object-fit="cover"
      ></video>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask"></view>
    </view>

    <view class="scene-layer shop-scene-layer">
    <view class="asset-card">
      <view class="asset-header">
        <text class="asset-label">当前账户余额</text>
        <text class="asset-tip">购买后可在对局页展示效果</text>
      </view>
      <view class="asset-body">
        <view class="asset-balance-main">
          <view class="coin-chip asset-coin-chip">
            <view class="coin-icon asset-coin-icon koi-coin">
              <view class="koi-coin-core">
                <view class="koi-fish-body"></view>
                <view class="koi-fish-eye"></view>
                <view class="koi-fish-fin"></view>
                <view class="koi-fish-tail tail-top"></view>
                <view class="koi-fish-tail tail-bottom"></view>
              </view>
            </view>
            <text class="asset-value">{{ balanceText }}</text>
          </view>
          <text class="asset-unit">锦鲤币</text>
        </view>
      </view>
      <view class="asset-sync-state">
        <text class="asset-sync-message">{{assetMessage}}</text>
        <button wx:if="{{syncFailed}}" class="asset-sync-retry" bindtap="refreshAccountAssets" disabled="{{syncing || actionPending}}" loading="{{syncing}}">重新同步</button>
      </view>
    </view>

    <view class="category-tabs">
      <view
        wx:for="{{ categories }}"
        wx:key="key"
        class="tab-item {{ activeCategory == item.key ? 'active' : '' }}"
        data-category="{{ item.key }}"
        bindtap="onSwitchCategory"
        hover-class="clickable-hover"
      >
        {{ item.label }}
        <view class="tab-line" wx:if="{{ activeCategory == item.key }}"></view>
      </view>
    </view>

    <view class="goods-grid">
      <view wx:for="{{ goods }}" wx:key="id" class="goods-card" hover-class="clickable-hover">
        <view class="goods-head">
          <view class="goods-badge">{{ item.category == 'skin' ? item.rarityLabel : item.category == 'ring' ? '头像光环' : '灵宠' }}</view>
        </view>
        
        <view class="goods-visual {{ item.category == 'skin' ? 'skin-photo' : item.category == 'ring' ? 'ring-photo' : 'pet-photo' }}">
          <view wx:if="{{ item.category == 'ring' }}" class="ring-preview-shell">
            <image class="ring-preview-avatar" src="{{ avatarUrl || defaultAvatar }}" mode="aspectFill" lazy-load="{{true}}"></image>
            <image class="ring-preview-overlay" src="{{ item.ringImage }}" mode="aspectFit" lazy-load="{{true}}"></image>
          </view>
          <image
            wx:if="{{ item.category == 'pet' && item.petImage }}"
            class="pet-cover"
            src="{{ item.petImage }}"
            mode="aspectFit"
            lazy-load="{{true}}"
          ></image>
          <image
            wx:elif="{{ item.category == 'skin' && item.skinImage }}"
            class="skin-cover"
            src="{{ item.skinImage }}"
            mode="aspectFit"
            lazy-load="{{true}}"
          ></image>
          <view wx:elif="{{ item.category != 'ring' }}" class="visual-placeholder">
            {{ item.category == 'skin' ? item.skinIcon : item.petIcon }}
          </view>
        </view>

        <view class="goods-info">
          <view class="goods-name">{{ item.name }}</view>
          <view class="goods-desc">{{ item.description }}</view>
        </view>

        <view
          class="goods-action-btn {{ item.status.action == 'buy' ? 'buy' : 'equip' }} {{ item.status.action == 'buy' && item.price !== 0 ? 'with-price' : '' }} {{ item.status.disabled ? 'disabled' : '' }}"
          data-category="{{ item.category }}"
          data-item-id="{{ item.id }}"
          data-action="{{ item.status.disabled ? '' : item.status.action }}"
          bindtap="onTapAction"
          hover-class="btn-hover"
        >
          <block wx:if="{{ item.status.action == 'buy' && item.price !== 0 }}">
            <view class="coin-icon buy-coin-icon koi-coin">
              <view class="koi-coin-core">
                <view class="koi-fish-body"></view>
                <view class="koi-fish-eye"></view>
                <view class="koi-fish-fin"></view>
                <view class="koi-fish-tail tail-top"></view>
                <view class="koi-fish-tail tail-bottom"></view>
              </view>
            </view>
            <text class="buy-price-text">{{ item.coinPriceText }}</text>
          </block>
          <block wx:else>
            {{ item.status.text }}
          </block>
        </view>
      </view>
    </view>
    </view>
  </view>
</view>
