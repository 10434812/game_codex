/* Oriental Paper Theme */
.shop-page {
  min-height: 100vh;
  padding: 14rpx 24rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.shop-avatar {
  background: var(--stage-chip, #ecdaba);
  color: var(--stage-deep, #a46d3e);
  border-color: var(--stage-border, #c9ab86);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.asset-card {
  margin-top: 14rpx;
  background: linear-gradient(145deg, var(--stage-panel-solid, #f7ecs0) 0%, var(--stage-panel, #f1e0bf) 100%);
  border: 3rpx solid var(--stage-border, #e0c8a1);
  border-radius: 28rpx;
  padding: 30rpx 36rpx;
  position: relative;
  box-shadow: 0 10rpx 24rpx var(--stage-shadow, rgba(125, 87, 43, 0.08)), inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  overflow: hidden;
  animation: shop-card-in 0.5s ease-out both;
}

.asset-card::before {
  content: '';
  position: absolute;
  left: -40%;
  top: 0;
  width: 32%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.52), transparent);
  transform: skewX(-18deg);
  animation: asset-sheen 3.4s ease-in-out infinite;
}

.asset-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.asset-label {
  color: var(--stage-deep, #8c6841);
  font-size: 26rpx;
  font-weight: 700;
}

.asset-tip {
  color: #80552d;
  font-size: 20rpx;
}

.asset-sync-state {
  position: relative;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.asset-sync-message {
  flex: 1;
  min-width: 240rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--stage-deep, #8c6841);
}

.asset-sync-retry {
  margin: 0;
  padding: 0 22rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--stage-deep, #8c6841);
  background: var(--stage-panel-solid, #f7ecs0);
}

.asset-body {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.asset-balance-main {
  min-width: 0;
}

.coin-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.coin-icon {
  flex-shrink: 0;
  border-radius: 50%;
  display: block;
}

.koi-coin {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 32% 28%, rgba(255, 245, 202, 0.98) 0%, rgba(255, 230, 146, 0.98) 28%, rgba(239, 162, 47, 0.98) 68%, rgba(192, 115, 22, 0.98) 100%);
  box-shadow:
    0 6rpx 14rpx rgba(154, 101, 39, 0.16),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.54),
    inset 0 -3rpx 5rpx rgba(141, 72, 18, 0.2);
}

.koi-coin-core {
  position: absolute;
  inset: 0;
}

.koi-fish-body {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 46%;
  height: 32%;
  border-radius: 60% 44% 50% 56%;
  background: linear-gradient(135deg, #fff8e8 0%, #fff1c5 22%, #ff9a2f 62%, #d96812 100%);
  transform: translate(-48%, -50%) rotate(-12deg);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.7);
}

.koi-fish-eye {
  position: absolute;
  top: 44%;
  left: 58%;
  width: 8%;
  height: 8%;
  border-radius: 50%;
  background: #744115;
  transform: translate(-50%, -50%);
}

.koi-fish-fin {
  position: absolute;
  top: 34%;
  left: 47%;
  width: 16%;
  height: 16%;
  border-radius: 70% 0 70% 20%;
  background: linear-gradient(135deg, rgba(255, 252, 240, 0.94), rgba(255, 176, 66, 0.9));
  transform: translate(-50%, -50%) rotate(-28deg);
  opacity: 0.96;
}

.koi-fish-tail {
  position: absolute;
  left: 25%;
  width: 18%;
  height: 16%;
  background: linear-gradient(135deg, rgba(255, 246, 216, 0.96), rgba(255, 147, 39, 0.92));
  border-radius: 24% 88% 24% 88%;
}

.koi-fish-tail.tail-top {
  top: 36%;
  transform: rotate(-38deg);
}

.koi-fish-tail.tail-bottom {
  top: 50%;
  transform: rotate(28deg);
}

.asset-coin-chip {
  align-items: center;
}

.asset-coin-icon {
  width: 38rpx;
  height: 38rpx;
}

.asset-value {
  color: var(--stage-primary, #dd7b15);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
  text-shadow: 0 2rpx 0 var(--stage-title, #eed9bf);
  animation: balance-pop 0.62s ease-out 0.18s both;
}

.asset-unit {
  display: block;
  margin-top: 8rpx;
  color: var(--stage-deep, #8f6a42);
  font-size: 22rpx;
  font-weight: 700;
}

.category-tabs {
  margin-top: 32rpx;
  display: flex;
  gap: 40rpx;
  padding: 0 16rpx;
  border-bottom: 2rpx solid var(--stage-border, #e2cbaa);
}

.tab-item {
  position: relative;
  padding-bottom: 16rpx;
  font-size: 30rpx;
  color: var(--stage-deep, #927555);
  font-weight: 600;
  transition: all 0.2s;
  animation: shop-card-in 0.4s ease-out both;
}

.tab-item.active {
  color: var(--stage-primary, #c96a10);
  font-weight: 800;
}

.tab-line {
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--stage-primary, #e57c1f);
  border-radius: 4rpx;
  animation: tab-line-grow 0.24s ease-out both;
}

.goods-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding-bottom: 40rpx;
}

.goods-card {
  background: var(--stage-panel, #fcf7eb);
  border: 2rpx solid var(--stage-border, #e1ceac);
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 16rpx var(--stage-shadow, rgba(135, 98, 54, 0.05));
  display: flex;
  flex-direction: column;
  min-width: 0;
  box-sizing: border-box;
  animation: goods-rise 0.48s ease-out both;
}

.goods-card:nth-child(2) { animation-delay: 0.05s; }
.goods-card:nth-child(3) { animation-delay: 0.1s; }
.goods-card:nth-child(4) { animation-delay: 0.15s; }
.goods-card:nth-child(5) { animation-delay: 0.2s; }
.goods-card:nth-child(6) { animation-delay: 0.25s; }

.goods-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.goods-badge {
  background: var(--stage-chip, #ebd2aa);
  color: var(--stage-deep, #855d28);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.price-num {
  font-size: 36rpx;
  font-weight: 900;
}

.goods-visual {
  margin-top: 16rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(255,255,255,0.6), 0 4rpx 10rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
  background: var(--stage-panel-solid, #f1ebd8);
  animation: visual-float 3s ease-in-out infinite;
}

.visual-placeholder {
  font-size: 72rpx;
  z-index: 2;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.15));
}

.pet-cover,
.skin-cover {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 16rpx;
}

.goods-visual.skin-photo {
  width: 280rpx;
  height: 280rpx;
  align-self: center;
  background: var(--stage-panel-solid, #efe5d3);
  border: 2rpx solid var(--stage-border, #dbc7a1);
}

.goods-visual.ring-photo {
  width: 280rpx;
  height: 280rpx;
  align-self: center;
  background:
    radial-gradient(circle at 50% 35%, var(--stage-title, rgba(255, 241, 206, 0.96)) 0%, var(--stage-panel, rgba(244, 230, 204, 0.92)) 38%, var(--stage-chip, rgba(235, 221, 195, 0.98)) 100%);
  border: 2rpx solid var(--stage-border, #dbc7a1);
}

/* Pets Backgrounds */
.goods-visual.pet-photo {
  height: 330rpx;
  background: var(--stage-panel-solid, #efe5d3);
  border: 2rpx solid var(--stage-border, #dbc7a1);
}

.ring-preview-shell {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-preview-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--stage-panel-solid, #f7edd8);
  box-shadow: 0 6rpx 16rpx var(--stage-shadow, rgba(132, 90, 41, 0.16));
}

.ring-preview-overlay {
  position: absolute;
  inset: -26rpx;
  width: auto;
  height: auto;
  animation: ring-preview-spin 6.4s linear infinite;
}

.goods-info {
  margin-top: 16rpx;
  flex: 1;
}

.goods-name {
  color: var(--stage-ink, #4a2d1a);
  font-size: 28rpx;
  font-weight: 800;
}

.goods-desc {
  margin-top: 6rpx;
  color: var(--stage-deep, #8a7051);
  font-size: 22rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-action-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 60rpx;
  border-radius: 999rpx;
  padding: 0 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fdf9f1;
  background: linear-gradient(135deg, var(--stage-bright, #f4b24a), var(--stage-primary, #e57c1f));
  box-shadow: 0 4rpx 12rpx var(--stage-glow, rgba(179, 101, 24, 0.2));
  box-sizing: border-box;
  white-space: nowrap;
  transition: transform 0.16s ease, filter 0.16s ease;
}

.goods-action-btn.with-price {
  gap: 12rpx;
}

.goods-action-btn::after {
  border: none;
}

.goods-action-btn.equip {
  background: var(--stage-deep, #d1ab64);
  color: #fff;
  box-shadow: 0 4rpx 12rpx var(--stage-glow, rgba(209, 171, 100, 0.2));
}

.goods-action-btn.disabled {
  opacity: 1;
  background: var(--stage-chip, #d2c4b0);
  box-shadow: none;
  color: #80552d;
}

.buy-coin-icon {
  width: 34rpx;
  height: 34rpx;
}

.buy-price-text {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.cursor-hover:active {
  transform: scale(0.97);
  transition: transform 0.1s;
}

@keyframes shop-card-in {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes asset-sheen {
  0%, 48% {
    left: -42%;
    opacity: 0;
  }
  62% {
    opacity: 1;
  }
  100% {
    left: 112%;
    opacity: 0;
  }
}

@keyframes balance-pop {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  70% {
    opacity: 1;
    transform: scale(1.05);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes tab-line-grow {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 48rpx;
    opacity: 1;
  }
}

@keyframes goods-rise {
  from {
    opacity: 0;
    transform: translateY(26rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes visual-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5rpx);
  }
}

@keyframes ring-preview-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
