.home-page {
  padding: 16rpx 22rpx 0;
}

.home-page .page-content {
  padding-bottom: calc(290rpx + env(safe-area-inset-bottom));
}

.home-page .theme-page-backdrop {
  opacity: 0.9;
}

.home-page .theme-page-backdrop .scene-backdrop-image {
  opacity: 0.74;
  filter: blur(12rpx) saturate(1.16) brightness(0.72);
}

.home-page .theme-page-backdrop .scene-backdrop-mask {
  background:
    radial-gradient(circle at 50% 32%, var(--stage-glow, rgba(245, 188, 96, 0.28)) 0%, transparent 30%),
    linear-gradient(180deg, rgba(8, 13, 26, 0.72) 0%, rgba(13, 18, 30, 0.48) 42%, rgba(47, 31, 16, 0.5) 72%, rgba(24, 17, 10, 0.72) 100%);
}

.topbar-spacer {
  box-sizing: border-box;
}

.hero-safe {
  box-sizing: border-box;
  width: 100%;
}

.hero-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-share-btn {
  flex: none;
  margin: 0;
  padding: 0 24rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--stage-border, #d2ad67);
  border-radius: 16rpx;
  background: var(--stage-panel, #fff8e8);
  color: var(--stage-deep, #80552d);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.home-share-btn::after {
  border: 0;
}

.hero-title {
  margin-top: 4rpx;
  color: var(--stage-primary, #dc7419);
  font-family: "Songti SC", "STSong", "Kaiti SC", "KaiTi", serif;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.02;
  letter-spacing: 3rpx;
  -webkit-text-stroke: 1rpx rgba(143, 76, 15, 0.12);
  text-shadow:
    0 10rpx 18rpx var(--stage-shadow, rgba(166, 88, 15, 0.16));
  animation: title-ink-rise 0.68s cubic-bezier(0.16, 1, 0.3, 1) both, title-luck-glow 3.4s ease-in-out 0.8s infinite;
}

.hero-copy {
  margin-top: 18rpx;
}

.subtitle {
  position: relative;
  max-width: 690rpx;
  color: rgba(255, 241, 209, 0.92);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0;
  white-space: normal;
  text-shadow: 0 4rpx 16rpx rgba(7, 9, 16, 0.48);
  animation: soft-slide-up 0.54s ease-out 0.12s both;
}

.profile-card {
  margin-top: 18rpx;
  padding: 28rpx 30rpx 24rpx;
  border-radius: 36rpx;
  background: var(--stage-panel, rgba(243, 228, 197, 0.96));
  border: 2rpx solid var(--stage-border, rgba(214, 186, 138, 0.42));
  box-shadow: 0 12rpx 24rpx var(--stage-shadow, rgba(123, 87, 41, 0.14));
  animation: soft-slide-up 0.42s ease-out both;
}

.profile-copy {
  display: flex;
  flex-direction: column;
}

.minor {
  font-size: 22rpx;
  color: var(--stage-deep, #977650);
  letter-spacing: 1rpx;
}

.title-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.name {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--stage-ink, #3a281a);
  line-height: 1.08;
}

.badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--stage-chip, rgba(232, 210, 167, 0.78));
  border: 2rpx solid var(--stage-border, rgba(206, 171, 113, 0.2));
  color: var(--stage-deep, #93683a);
  font-size: 22rpx;
  font-weight: 600;
}

.profile-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--stage-deep, #856642);
  line-height: 1.4;
}

.profile-divider {
  margin: 20rpx 0 18rpx;
  height: 2rpx;
  background: var(--stage-border, rgba(206, 177, 132, 0.42));
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.account-copy {
  min-width: 0;
}

.clickable {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.label {
  font-size: 24rpx;
  color: var(--stage-deep, #9c7a4f);
}

.value {
  margin-top: 4rpx;
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.05;
}

.value.gold {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 46rpx;
  white-space: nowrap;
}

.currency-amount {
  font-size: inherit;
}

.currency-unit {
  font-size: inherit;
  font-weight: 900;
}

.currency-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.gold {
  color: var(--stage-primary, #d97712);
}

.jump-hint {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  color: var(--stage-deep, #93683a);
  background: var(--stage-chip, rgba(232, 210, 167, 0.78));
  border: 2rpx solid var(--stage-border, rgba(206, 171, 113, 0.2));
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.exp-progress {
  margin-top: 16rpx;
}

.exp-track {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--stage-chip, rgba(214, 186, 138, 0.34));
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--stage-bright, #f5bc60), var(--stage-soft, #eb9230) 58%, var(--stage-primary, #e57c1f));
  box-shadow: 0 0 14rpx var(--stage-glow, rgba(229, 124, 31, 0.28));
  transition: width 0.45s ease;
}

.profile-card-wrap {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.profile-card-wrap.expanded {
  max-height: 600rpx;
}

.expand-toggle {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  color: rgba(255, 236, 198, 0.9);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 999rpx;
  background: rgba(8, 14, 25, 0.24);
  border: 2rpx solid rgba(255, 222, 157, 0.18);
  backdrop-filter: blur(8rpx);
  text-shadow: 0 3rpx 10rpx rgba(7, 10, 16, 0.4);
  animation: soft-slide-up 0.48s ease-out 0.18s both;
}

.section-head {
  margin: 28rpx 0 18rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  animation: soft-slide-up 0.48s ease-out 0.26s both;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: var(--stage-bright, #f5bc60);
  font-weight: 800;
  letter-spacing: 3rpx;
  text-shadow: 0 4rpx 14rpx rgba(31, 18, 8, 0.26);
}

.section-title::before {
  content: '';
  width: 74rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, var(--stage-bright, #f5bc60));
}

.section-tip {
  font-size: 22rpx;
  color: rgba(255, 241, 205, 0.82);
  text-shadow: 0 3rpx 10rpx rgba(20, 12, 6, 0.28);
}

.destination-card {
  position: relative;
  margin: 0 -22rpx;
  padding: 10rpx 0 116rpx;
  overflow: visible;
  background: transparent;
  box-shadow: none;
  animation: card-float-in 0.62s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
}

.destination-card::before {
  content: '';
  position: absolute;
  left: 86rpx;
  right: 86rpx;
  bottom: 68rpx;
  height: 84rpx;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 50% 50%, rgba(255, 205, 103, 0.55) 0%, rgba(184, 93, 20, 0.18) 42%, transparent 72%),
    linear-gradient(90deg, transparent, rgba(255, 226, 150, 0.38), transparent);
  filter: blur(6rpx);
  pointer-events: none;
}

.destination-card::after {
  content: '';
  position: absolute;
  left: 72rpx;
  right: 72rpx;
  bottom: 86rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 225, 148, 0.68), transparent);
  box-shadow: 0 0 34rpx rgba(255, 196, 76, 0.42);
  pointer-events: none;
}

.stage-swiper {
  position: relative;
  z-index: 2;
  height: clamp(440rpx, calc(100vh - 740rpx - env(safe-area-inset-bottom)), 720rpx);
  overflow: visible;
}

.stage-item {
  position: relative;
  height: 100%;
  margin: 0 8rpx;
  border: 2rpx solid rgba(255, 226, 158, 0.62);
  border-radius: 42rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #091225;
  box-shadow:
    0 26rpx 50rpx rgba(9, 11, 20, 0.42),
    0 0 0 1rpx rgba(115, 75, 28, 0.46),
    inset 0 0 38rpx rgba(255, 206, 119, 0.18);
  transform: translateZ(0);
  transition: transform 0.34s ease, opacity 0.34s ease, filter 0.34s ease;
}

.stage-item-active {
  opacity: 1;
  transform: translateZ(0) scale(1);
}

.stage-item-side {
  opacity: 0.58;
  filter: saturate(0.88) brightness(0.72);
  transform: translateZ(0) scale(0.88);
}

.stage-item-side .stage-info,
.stage-item-side .stage-online,
.stage-item-side .tag,
.stage-item-side .stage-frame-line,
.stage-item-side .frame-corner {
  opacity: 0;
}

.stage-frame-line {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  z-index: 6;
  border: 2rpx solid rgba(255, 229, 166, 0.72);
  border-radius: 34rpx;
  box-shadow:
    0 0 18rpx rgba(255, 201, 90, 0.28),
    inset 0 0 18rpx rgba(255, 242, 199, 0.16);
  pointer-events: none;
}

.stage-frame-line::before,
.stage-frame-line::after {
  content: '';
  position: absolute;
  left: 86rpx;
  right: 86rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 233, 178, 0.8), transparent);
}

.stage-frame-line::before {
  top: 10rpx;
}

.stage-frame-line::after {
  bottom: 10rpx;
}

.frame-corner {
  position: absolute;
  z-index: 7;
  width: 84rpx;
  height: 84rpx;
  pointer-events: none;
}

.corner-tl,
.corner-tr {
  top: 8rpx;
  border-top: 6rpx solid rgba(255, 225, 147, 0.92);
}

.corner-bl,
.corner-br {
  bottom: 8rpx;
  border-bottom: 6rpx solid rgba(255, 225, 147, 0.92);
}

.corner-tl,
.corner-bl {
  left: 8rpx;
  border-left: 6rpx solid rgba(255, 225, 147, 0.92);
}

.corner-tr,
.corner-br {
  right: 8rpx;
  border-right: 6rpx solid rgba(255, 225, 147, 0.92);
}

.corner-tl { border-radius: 34rpx 0 0 0; }
.corner-tr { border-radius: 0 34rpx 0 0; }
.corner-bl { border-radius: 0 0 0 34rpx; }
.corner-br { border-radius: 0 0 34rpx 0; }

.stage-arrow {
  position: absolute;
  top: calc(50% - 88rpx);
  z-index: 9;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffe29b;
  font-size: 72rpx;
  font-family: "Times New Roman", serif;
  line-height: 0.9;
  background:
    radial-gradient(circle at 38% 32%, rgba(255, 221, 143, 0.22), transparent 36%),
    rgba(6, 14, 28, 0.92);
  border: 3rpx solid rgba(255, 220, 139, 0.72);
  box-shadow:
    0 10rpx 22rpx rgba(4, 8, 17, 0.38),
    inset 0 0 18rpx rgba(255, 213, 124, 0.16);
}

.stage-arrow-left {
  left: 44rpx;
  padding-right: 6rpx;
}

.stage-arrow-right {
  right: 44rpx;
  padding-left: 6rpx;
}

.tag {
  position: absolute;
  left: 30rpx;
  top: 30rpx;
  z-index: 8;
  min-width: 104rpx;
  padding: 13rpx 22rpx 14rpx;
  box-sizing: border-box;
  border-radius: 34rpx 12rpx 34rpx 12rpx;
  color: #ffe9bd;
  font-family: "Songti SC", "STSong", "Kaiti SC", "KaiTi", serif;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  border: 2rpx solid rgba(255, 218, 143, 0.66);
  box-shadow:
    0 8rpx 20rpx rgba(80, 22, 5, 0.3),
    inset 0 0 18rpx rgba(255, 220, 143, 0.24);
  animation: tag-pop 0.42s ease-out 0.62s both;
}

.tag-hot {
  background: linear-gradient(135deg, #e84f1f 0%, #ae2411 58%, #5f160f 100%);
  text-shadow: 0 3rpx 8rpx rgba(75, 17, 4, 0.5);
}

.tag-choice {
  background: linear-gradient(135deg, #24405d 0%, #12233f 62%, #07111f 100%);
  color: #f4d49a;
}

.stage-online {
  position: absolute;
  top: 38rpx;
  right: 38rpx;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: rgba(255, 237, 202, 0.94);
  font-size: 30rpx;
  font-weight: 800;
  background: rgba(10, 17, 29, 0.46);
  border: 1rpx solid rgba(255, 222, 159, 0.3);
  backdrop-filter: blur(8rpx);
  text-shadow: 0 2rpx 8rpx rgba(4, 8, 16, 0.6);
}

.online-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0d1727;
  font-size: 22rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffe7a7, #d59b44);
}

.stage-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 0;
  transform: scale(1.02);
  animation: stage-drift 9s ease-in-out infinite alternate;
}

.stage-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  opacity: 0.96;
}

.stage-vignette {
  position: absolute;
  inset: 0;
  z-index: 3;
  background:
    radial-gradient(circle at 50% 18%, transparent 0%, rgba(7, 10, 17, 0.08) 46%, rgba(3, 7, 14, 0.44) 100%),
    linear-gradient(180deg, rgba(5, 10, 20, 0.22) 0%, transparent 34%, rgba(3, 7, 13, 0.2) 56%, rgba(4, 8, 14, 0.92) 100%);
  pointer-events: none;
}

.stage-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 110rpx 28rpx 80rpx;
  text-align: center;
  background: linear-gradient(180deg, transparent 0%, rgba(5, 8, 15, 0.32) 32%, rgba(5, 8, 15, 0.84) 100%);
  animation: soft-slide-up 0.56s ease-out 0.48s both;
}

.dest-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f6dfb0;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(2, 6, 12, 0.56);
}

.dest-name {
  font-size: 48rpx;
  color: #fff0c9;
  font-weight: 900;
  line-height: 1.12;
  font-family: "Songti SC", "STSong", "Kaiti SC", "KaiTi", serif;
  letter-spacing: 4rpx;
  -webkit-text-stroke: 1rpx rgba(255, 237, 190, 0.42);
  text-shadow:
    0 3rpx 0 rgba(61, 32, 8, 0.48),
    0 0 14rpx rgba(255, 224, 160, 0.52),
    0 12rpx 22rpx rgba(2, 6, 12, 0.72);
}

.stage-item-active .dest-name {
  font-size: 52rpx;
}

.dest-sub {
  margin: 22rpx auto 0;
  min-height: 58rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  color: #ffe29b;
  font-size: 30rpx;
  font-weight: 900;
  background:
    linear-gradient(180deg, rgba(35, 24, 10, 0.84), rgba(9, 13, 22, 0.84)),
    rgba(9, 13, 22, 0.72);
  border: 2rpx solid rgba(255, 217, 128, 0.38);
  box-shadow:
    0 8rpx 18rpx rgba(0, 0, 0, 0.24),
    inset 0 0 18rpx rgba(255, 210, 116, 0.12);
  text-shadow: 0 2rpx 8rpx rgba(35, 15, 0, 0.54);
}

.income-coin {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a4c0b;
  font-size: 20rpx;
  line-height: 1;
  background: linear-gradient(135deg, #fff2b8, #e5a934 70%, #9e5d12);
  box-shadow: 0 0 12rpx rgba(255, 210, 84, 0.42);
}

.income-rise {
  color: #6cf1a1;
  font-size: 34rpx;
  text-shadow: 0 0 12rpx rgba(83, 238, 143, 0.52);
}

.stage-dots {
  position: relative;
  z-index: 5;
  margin-top: -70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.stage-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(255, 229, 178, 0.34);
  border: 2rpx solid rgba(255, 233, 176, 0.24);
  box-shadow: inset 0 2rpx 6rpx rgba(4, 8, 15, 0.4);
}

.stage-dot.active {
  background: linear-gradient(135deg, #fff4b8, #e4a329);
  border-color: rgba(255, 241, 185, 0.78);
  box-shadow:
    0 0 16rpx rgba(255, 205, 84, 0.62),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.28);
}

.start-btn {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(166rpx + env(safe-area-inset-bottom));
  z-index: 18;
  margin: 0;
  height: 88rpx;
  font-size: 32rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx var(--stage-glow, rgba(229, 124, 31, 0.4));
}

.home-page .bottom-nav {
  z-index: 20;
}

.start-btn::before {
  content: '';
  position: absolute;
  left: -30%;
  top: 0;
  width: 28%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), transparent);
  transform: skewX(-18deg);
}

@keyframes btn-breathe {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 20rpx var(--stage-glow, rgba(229, 124, 31, 0.4));
  }
  50% {
    transform: scale(1.03);
    box-shadow: 0 12rpx 28rpx var(--stage-glow, rgba(229, 124, 31, 0.6));
  }
}

.start-btn::after {
  border: none;
}

@keyframes title-ink-rise {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.96);
    filter: blur(2rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

@keyframes title-luck-glow {
  0%, 100% {
    text-shadow:
      0 10rpx 18rpx var(--stage-shadow, rgba(166, 88, 15, 0.16));
  }
  50% {
    text-shadow:
      0 14rpx 26rpx var(--stage-glow, rgba(224, 124, 29, 0.32));
  }
}

@keyframes soft-slide-up {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-float-in {
  from {
    opacity: 0;
    transform: translateY(34rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes tag-pop {
  from {
    opacity: 0;
    transform: translateY(-10rpx) scale(0.82);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes stage-drift {
  from {
    transform: scale(1.02) translate3d(-8rpx, 0, 0);
  }
  to {
    transform: scale(1.07) translate3d(10rpx, -8rpx, 0);
  }
}

@keyframes btn-sheen {
  0%, 45% {
    left: -34%;
    opacity: 0;
  }
  58% {
    opacity: 1;
  }
  100% {
    left: 108%;
    opacity: 0;
  }
}

/* ─── 公告横幅 + 公告弹窗（运营公告消费端） ─── */
.announcement-banner {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(8, 14, 25, 0.46);
  border: 2rpx solid rgba(255, 222, 157, 0.22);
  backdrop-filter: blur(8rpx);
  animation: soft-slide-up 0.48s ease-out 0.2s both;
}

.announcement-banner-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #4a2d1a;
  font-size: 22rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ffe7a7, #e5a934 70%, #9e5d12);
  box-shadow: 0 0 12rpx rgba(255, 210, 84, 0.4);
}

.announcement-banner-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 241, 209, 0.94);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: 0 3rpx 10rpx rgba(7, 10, 16, 0.4);
}

.announcement-banner-more {
  flex-shrink: 0;
  color: rgba(255, 226, 158, 0.86);
  font-size: 22rpx;
  font-weight: 600;
}

.announcement-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(5, 8, 15, 0.66);
  backdrop-filter: blur(6rpx);
  animation: mask-fade-in 0.22s ease-out both;
}

.announcement-modal {
  width: 640rpx;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fdf3dd 0%, #f6ebd1 100%);
  border: 2rpx solid rgba(214, 186, 138, 0.5);
  box-shadow: 0 30rpx 70rpx rgba(3, 6, 12, 0.5);
  animation: modal-rise 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.announcement-modal-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 34rpx 22rpx;
  border-bottom: 2rpx solid rgba(206, 177, 132, 0.4);
}

.announcement-modal-title {
  color: #4a2d1a;
  font-family: "Songti SC", "STSong", "Kaiti SC", "KaiTi", serif;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.announcement-modal-close {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #8a7051;
  font-size: 30rpx;
  background: rgba(214, 186, 138, 0.3);
}

.announcement-modal-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 34rpx 36rpx;
  box-sizing: border-box;
}

.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.announcement-list-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(206, 177, 132, 0.28);
  background: rgba(255, 252, 246, 0.72);
}

.announcement-list-item.active {
  border-color: rgba(229, 124, 31, 0.55);
  background: rgba(255, 244, 222, 0.9);
  box-shadow: 0 0 0 2rpx rgba(229, 124, 31, 0.12);
}

.announcement-type-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  background: #8a7051;
}

.announcement-type-tag.type-event {
  background: #e57c1f;
}

.announcement-type-tag.type-maintenance {
  background: #d9534f;
}

.announcement-type-tag.type-reward {
  background: #2bbf9f;
}

.announcement-list-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #4a2d1a;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.announcement-detail {
  padding: 8rpx 4rpx 0;
}

.announcement-detail-title {
  color: #3a281a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.announcement-detail-meta {
  margin-top: 10rpx;
  color: #9c7a4f;
  font-size: 22rpx;
}

.announcement-detail-content {
  margin-top: 20rpx;
  color: #5d4630;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

@keyframes mask-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes modal-rise {
  from {
    opacity: 0;
    transform: translateY(36rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
.summary-retry {
  margin: 12rpx 0 0;
  padding: 12rpx 16rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--stage-ink, #4a2f17);
  background: var(--stage-panel-solid, #fff8ea);
}

.home-entry-actions { position:fixed; left:48rpx; right:48rpx; bottom:calc(166rpx + env(safe-area-inset-bottom)); z-index:18; display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:16rpx; }
.home-entry-actions .start-btn { position:relative; left:auto; right:auto; bottom:auto; min-width:0; width:100%; }
.home-entry-actions.single-entry { grid-template-columns:1fr; }
/* 底部导航收起后按钮下移，只给右下角箭头留位置 */
.home-entry-actions.nav-collapsed { bottom:calc(128rpx + env(safe-area-inset-bottom)); }
.guide-home .guide-action-panel {
  /* 与首页入口按钮同位同布局，引导按钮正好"替换"真实按钮 */
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.guide-home .guide-action-panel.single-entry { grid-template-columns: 1fr; }
/* 导航展开时与入口按钮一样抬到导航上方 */
.guide-home .guide-action-panel.nav-open { bottom: calc(166rpx + env(safe-area-inset-bottom)); }
.friend-room-btn {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #8d541d;
  border-radius: 999rpx;
  color: #573013;
  background: #fff5de;
  font-size: 32rpx;
  font-weight: 700;
}
.friend-room-btn::after { border: 0; }
