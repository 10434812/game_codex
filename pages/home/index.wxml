<view class="paper-bg home-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg.png" mode="scaleToFill"></image>
  <view class="app-header" style="padding-top: {{ nav.statusBarHeight }}px; padding-right: {{ nav.capsuleSpace }}px;">
    <view class="app-user" bindtap="onTapProfile" hover-class="clickable-hover">
      <image wx:if="{{userProfile.avatarUrl}}" class="app-user-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
      <image wx:else class="app-user-avatar" src="{{defaultAvatar}}" mode="aspectFill"></image>
      <text class="app-user-name">{{userProfile.nickName}}</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-dot">●</text>
        <text class="app-status-text">{{activeSessionId ? '联机进行中' : modeText}}</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop theme-page-backdrop home-scene-backdrop" wx:if="{{stageImage || stageVideo}}">
      <image wx:if="{{stageImage}}" class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <video
        wx:if="{{stageVideo}}"
        id="scene-backdrop-video"
        class="scene-backdrop-video"
        src="{{stageVideo}}"
        poster="{{stageImage}}"
        autoplay
        muted
        loop
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        show-fullscreen-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        object-fit="cover"
      ></video>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask"></view>
    </view>

    <view class="scene-layer home-scene-layer">
    <view class="hero-safe">
      <view class="hero-heading">
        <view class="hero-title">锦鲤前程</view>
        <button wx:if="{{shareEnabled}}" class="home-share-btn" open-type="share" aria-label="分享游戏给好友" hover-class="btn-hover">分享好友</button>
      </view>
      <view class="hero-copy">
        <view class="subtitle">120 秒跑动接福袋、抢礼物、躲雷，个人积分最高者获胜。</view>
      </view>
    </view>

    <view class="announcement-banner" wx:if="{{announcements.length}}" bindtap="openAnnouncement" data-index="0" hover-class="clickable-hover">
      <view class="announcement-banner-tag">公告</view>
      <text class="announcement-banner-text">{{announcements[0].title}}</text>
      <text class="announcement-banner-more">{{announcements.length > 1 ? '等' + announcements.length + '条 ›' : '查看 ›'}}</text>
    </view>

    <view class="expand-toggle" bindtap="toggleProfileCard" hover-class="clickable-hover">
      <text class="expand-toggle-icon" wx:if="{{!showProfileCard}}">▼</text>
      <text class="expand-toggle-icon" wx:else>▲</text>
      <text class="expand-toggle-text" wx:if="{{!showProfileCard}}">查看我的资产</text>
      <text class="expand-toggle-text" wx:else>收起资产</text>
    </view>

    <view class="profile-card-wrap {{showProfileCard ? 'expanded' : ''}}">
      <view class="card profile-card">
        <view class="profile-copy">
          <view class="minor">当前等级</view>
          <view class="title-row">
            <view class="name">{{levelText}}</view>
            <view class="badge" bindtap="onTapTasks" hover-class="clickable-hover">每日任务</view>
            <view class="badge">旅行成长</view>
          </view>
          <view class="profile-meta">{{experienceText}}</view>
        </view>
        <view class="exp-progress">
          <view class="exp-track">
            <view class="exp-fill" style="width: {{progressVisualPercent}}%;"></view>
          </view>
        </view>
        <view class="profile-divider"></view>
        <view class="account-row clickable" bindtap="onTapIncome" hover-class="clickable-hover">
          <view class="account-copy">
            <text class="label">我的锦鲤币</text>
            <view class="value gold currency-line">
              <image class="currency-icon" src="https://xcx.ukb88.com/assets/icons/koi-coin.svg" mode="aspectFit"></image>
              <text class="currency-unit">锦鲤币</text>
              <text class="currency-amount">{{balanceAmountText}}</text>
            </view>
          </view>
          <view class="jump-hint">查看明细 ›</view>
        </view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">目的地卡册</view>
      <view class="section-tip">左右滑动切换</view>
    </view>

    <view class="destination-card">
      <view class="stage-arrow stage-arrow-left" bindtap="onPrevStage" hover-class="clickable-hover">‹</view>
      <view class="stage-arrow stage-arrow-right" bindtap="onNextStage" hover-class="clickable-hover">›</view>
      <swiper class="stage-swiper" indicator-dots="{{ false }}" circular="{{ true }}" current="{{ activeStage }}" previous-margin="72rpx" next-margin="72rpx" bindchange="onStageChange">
        <swiper-item wx:for="{{ stages }}" wx:key="id" wx:for-index="stageIndex">
          <view class="stage-item {{ activeStage === stageIndex ? 'stage-item-active' : 'stage-item-side' }}" style="--stage-title-color: {{ item.titleColor }}; --stage-accent-color: {{ item.accentColor }};">
            <view class="stage-frame-line"></view>
            <view class="frame-corner corner-tl"></view>
            <view class="frame-corner corner-tr"></view>
            <view class="frame-corner corner-bl"></view>
            <view class="frame-corner corner-br"></view>
            <view class="tag {{ item.hot ? 'tag-hot' : 'tag-choice' }}">{{ item.hot ? 'HOT' : '精选' }}</view>
            <image wx:if="{{item.image}}" class="stage-image" src="{{ item.image }}" mode="aspectFill" lazy-load="{{true}}"></image>
            <video
              wx:if="{{ item.video && activeStage === stageIndex }}"
              id="stage-video-{{stageIndex}}"
              class="stage-video"
              data-stage-index="{{stageIndex}}"
              src="{{ item.video }}"
              poster="{{ item.image }}"
              autoplay="{{true}}"
              muted="{{true}}"
              loop
              controls="{{false}}"
              show-center-play-btn="{{false}}"
              show-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              enable-progress-gesture="{{false}}"
              object-fit="cover"
              bindloadedmetadata="onStageVideoReady"
            ></video>
            <view class="stage-vignette"></view>
            <view class="stage-info">
              <view class="dest-name">{{ item.name }}</view>
              <view class="dest-meta">{{ item.slogan }}</view>
              <view class="dest-sub">
                <text class="income-coin">赛</text>
                <text>120 秒个人积分赛</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="stage-dots">
        <view wx:for="{{ stages }}" wx:key="id" class="stage-dot {{ activeStage === index ? 'active' : '' }}"></view>
      </view>
    </view>

    <button class="primary-btn start-btn" bindtap="startGame" hover-class="btn-hover">{{activeSessionId ? '返回联机对局' : '本地体验 · 进入房间'}}</button>

    <view class="bottom-nav">
      <view wx:for="{{ tabs }}" wx:key="key" class="nav-item {{ activeTab === item.key ? 'active' : '' }}" data-page="{{ item.page }}" bindtap="switchTab" hover-class="clickable-hover">
        <view class="nav-dot"><image class="nav-icon" src="{{activeTab===item.key ? item.iconActive : item.icon}}" mode="aspectFit"></image></view>
        <text>{{ item.label }}</text>
      </view>
    </view>
    </view>

    <view class="announcement-mask" wx:if="{{announcementVisible}}" bindtap="closeAnnouncement">
      <view class="announcement-modal" catchtap="onAnnouncementNoop">
        <view class="announcement-modal-head">
          <text class="announcement-modal-title">官方公告</text>
          <text class="announcement-modal-close" bindtap="closeAnnouncement">✕</text>
        </view>
        <scroll-view class="announcement-modal-body" scroll-y>
          <view class="announcement-list" wx:if="{{announcements.length > 1}}">
            <view
              wx:for="{{announcements}}"
              wx:key="id"
              class="announcement-list-item {{activeAnnouncement.id === item.id ? 'active' : ''}}"
              data-index="{{index}}"
              bindtap="onSelectAnnouncement"
            >
              <text class="announcement-type-tag type-{{item.type}}">{{item.type === 'system' ? '系统' : item.type === 'event' ? '活动' : item.type === 'maintenance' ? '维护' : '奖励'}}</text>
              <text class="announcement-list-title">{{item.title}}</text>
            </view>
          </view>
          <view class="announcement-detail" wx:if="{{activeAnnouncement}}">
            <view class="announcement-detail-title">{{activeAnnouncement.title}}</view>
            <view class="announcement-detail-meta">{{activeAnnouncement.publishedAt}}</view>
            <view class="announcement-detail-content">{{activeAnnouncement.content}}</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="guide-overlay guide-home" wx:if="{{guideVisible}}">
      <view class="guide-mask"></view>
      <view class="guide-card guide-card-top">
        <view class="guide-kicker">新手引导 1/5</view>
        <view class="guide-title">选好景区，进入本地体验房间；也可在房间内创建好友联机。</view>
      </view>
      <view class="guide-action-panel">
        <button class="guide-primary" bindtap="onGuidePrimary" hover-class="btn-hover">进入体验房间</button>
      </view>
    </view>
  </view>
</view>
