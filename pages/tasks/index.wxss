.tasks-page { min-height: 100vh; padding: 12rpx 24rpx 48rpx; box-sizing: border-box; }
.task-intro { padding: 36rpx 0 20rpx; }
.task-heading { display: block; font-size: 44rpx; font-weight: 700; color: var(--red-primary, #8d3b23); margin-bottom: 12rpx; }
.task-note { display: block; font-size: 25rpx; color: #795c3d; line-height: 1.7; }
.task-list { margin-top: 24rpx; border-top: 2rpx solid #d8bb8d; }
.task-row { display: flex; align-items: center; gap: 16rpx; padding: 32rpx 0; border-bottom: 2rpx solid #d8bb8d; }
.task-details { flex: 1; min-width: 0; }
.task-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; }
.task-claim { flex-shrink: 0; margin: 0; background: #e57c1f; color: #fff; font-size: 28rpx; min-width: 144rpx; min-height: 88rpx; }
.task-claim[disabled] { background: #e4d4b8; color: #795c3d; }
.task-back { margin: 0; font-size: 26rpx; }
.task-message { padding: 40rpx 0; font-size: 28rpx; line-height: 1.7; }
.task-rules { margin-top: 32rpx; }
.task-login { margin-top: 24rpx; min-height: 88rpx; font-size: 30rpx; }

.retention-section { margin:28rpx 0; padding:24rpx 0; border-bottom:2rpx solid #d8bb8d; }
.retention-heading { font-size:36rpx; margin-bottom:16rpx; }
.checkin-calendar { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:6rpx; margin:24rpx 0; }
.checkin-day { padding:18rpx 2rpx; background:#e9dcc2; border:2rpx solid transparent; border-radius:10rpx; text-align:center; color:#704a29; font-size:23rpx; }
.checkin-day text { display:block; line-height:1.8; }
.checkin-current { border-color:#97531b; font-weight:700; background:#fff3d6; }
.checkin-claimed { color:#4e6b43; }
.checkin-button { width:100%; margin:0 0 16rpx; }
.rank-open { color:#704418; background:#ead9b9; min-height:88rpx; font-size:28rpx; }
.passport-stamps { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:18rpx; }
.passport-stamp { padding:18rpx 22rpx; border:2rpx dashed #b79570; border-radius:12rpx; color:#704a29; font-size:28rpx; }
.passport-stamped { border-style:solid; border-color:#a24a36; color:#893b2a; font-weight:600; background:#fff3d6; }
.passport-badge { display:block; color:#893b2a; font-size:28rpx; font-weight:700; margin-top:8rpx; }
.weekend-open { display:flex; align-items:center; justify-content:center; margin-top:12rpx; border-radius:10rpx; }
