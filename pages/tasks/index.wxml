<view class="paper-bg tasks-page">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg.png" mode="scaleToFill" />
  <view class="app-header" style="padding-top: {{nav.statusBarHeight}}px; padding-right: {{nav.capsuleSpace}}px;">
    <text class="app-user-name">每日任务</text>
    <button class="task-back" bindtap="onBack">返回</button>
  </view>
  <view class="page-content">
    <view class="task-intro"><text class="task-heading">今日积福</text><text class="task-note">每天完成小目标，领取锦鲤币奖励</text></view>
    <text class="task-note">北京时间每日 00:00 重置 · {{date}}</text>
    <view wx:if="{{loading}}" class="task-message">正在加载今日任务…</view>
    <view wx:elif="{{loginRequired || loginPending}}" class="task-message">
      <text>{{error || '微信登录后即可查看今日任务并领取奖励。'}}</text>
      <button class="primary-btn task-login" bindtap="onLogin" loading="{{loginPending}}" disabled="{{loginPending}}">{{loginPending ? '正在微信登录' : '微信登录并查看任务'}}</button>
    </view>
    <view wx:elif="{{error}}" class="task-message"><text>{{error}}</text><button bindtap="loadTasks">重新加载</button></view>
    <view wx:else class="task-list">
      <view wx:if="{{retention}}" class="retention-section">
        <text class="task-heading retention-heading">每日签到</text>
        <text class="task-note">已连续 {{retention.checkin.streak}} 天 · 今日为第 {{retention.checkin.day}} 日</text>
        <view class="checkin-calendar">
          <view wx:for="{{retention.checkin.calendar}}" wx:key="day" class="checkin-day {{item.current ? 'checkin-current' : ''}} {{item.claimed ? 'checkin-claimed' : ''}}"><text>第{{item.day}}日</text><text>+{{item.reward}}</text></view>
        </view>
        <button class="task-claim checkin-button" data-id="checkin" bindtap="claimRetention" loading="{{retentionClaiming === 'checkin'}}" disabled="{{retention.checkin.claimed || claiming || retentionClaiming}}">{{retention.checkin.claimed ? '今日已签到' : '签到领取 ' + retention.checkin.reward + ' 锦鲤币'}}</button>
        <text class="task-note">奖励每7天一轮；中断后从第1日开始，北京时间00:00更新。</text>
      </view>
      <view wx:for="{{tasks}}" wx:key="id" class="task-row">
        <view class="task-details"><text class="task-title">{{item.title}}</text><text class="task-note">进度 {{item.progress}} / {{item.target}} · 奖励 {{item.reward}} 锦鲤币</text></view>
        <button class="task-claim" data-id="{{item.id}}" bindtap="claimReward" loading="{{item.isLoading}}" disabled="{{item.disabled}}">{{item.buttonText}}</button>
      </view>
    </view>
    <view wx:if="{{retention && !loading && !error && !loginRequired}}" class="retention-section">
      <text class="task-heading retention-heading">成长目标</text>
      <text class="task-note">Lv.{{retention.level}} · 累计 {{retention.totalExp}} 经验 · 已完成 {{retention.games}} 局</text>
      <view wx:for="{{retention.milestones}}" wx:key="id" class="task-row">
        <view class="task-details"><text class="task-title">{{item.title}}</text><text class="task-note">{{item.progress}} / {{item.target}} · 奖励 {{item.reward}} 锦鲤币</text></view>
        <button class="task-claim" data-id="{{item.id}}" bindtap="claimRetention" loading="{{retentionClaiming === item.id}}" disabled="{{item.claimed || item.progress < item.target || claiming || retentionClaiming}}">{{item.claimed ? '已领取' : item.progress < item.target ? '未完成' : '领取'}}</button>
      </view>
    </view>
    <view wx:if="{{retention.passport && !loading && !error && !loginRequired}}" class="retention-section">
      <text class="task-heading retention-heading">景区护照</text>
      <text class="task-note">已集 {{retention.passport.stampedCount}} / {{retention.passport.stages.length}} 枚印章 · 首次完成景区联机对局自动盖章</text>
      <text class="passport-badge" wx:if="{{retention.passport.badge}}">已获得「全景区巡游」徽章</text>
      <text class="task-note" wx:else>集齐印章，获得「全景区巡游」徽章。</text>
      <view class="passport-stamps">
        <view class="passport-stamp {{item.stamped ? 'passport-stamped' : ''}}" wx:for="{{retention.passport.stages}}" wx:key="id">
          <text>{{item.name}}</text><text class="task-note">{{item.stamped ? '已盖章' : '待探索'}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!loading && !error && !loginRequired}}" class="retention-section">
      <navigator class="rank-open weekend-open" url="/pages/weekend/index">查看周末活动</navigator>
    </view>
    <view wx:if="{{!loading && !error && !loginRequired}}" class="retention-section">
      <button class="rank-open" bindtap="showLeaderboard">查看经验排行榜</button>
      <text class="task-note">全服前20名，按累计经验排序，同经验并列。</text>
      <view wx:if="{{leaderboardVisible}}">
        <text wx:if="{{rankLoading}}" class="task-note">正在同步经验榜…</text>
        <view wx:elif="{{rankError}}"><text class="task-note">{{rankError}}</text><button bindtap="loadLeaderboard">重新加载排行榜</button></view>
        <block wx:else>
          <view wx:for="{{leaderboard}}" wx:key="id" class="task-row"><view class="task-details"><text class="task-title">{{item.rank}} · {{item.nickName}}</text><text class="task-note">Lv.{{item.level}} · {{item.totalExp}} 经验</text></view></view>
          <text wx:if="{{!leaderboard.length}}" class="task-note">暂无排行，完成对局后再来看看。</text>
        </block>
      </view>
    </view>
    <text class="task-note task-rules">仅统计正常结算的联机对局；组队任务需结算时保持组队。中断对局不计入。每日任务未领奖励不跨日保留；成长目标奖励长期可领，每项仅一次。</text>
  </view>
</view>
