<view class="paper-bg room-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg2.png" mode="scaleToFill"></image>
  <view class="app-header" style="padding-top: {{nav.statusBarHeight}}px; padding-right: {{nav.capsuleSpace}}px;">
    <view class="app-user" bindtap="onTapProfile" hover-class="clickable-hover">
      <image wx:if="{{userProfile.avatarUrl}}" class="app-user-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
      <image wx:else class="app-user-avatar" src="{{defaultAvatar}}" mode="aspectFill"></image>
      <text class="app-user-name">{{userProfile.nickName}}</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-dot">●</text>
        <text class="app-status-text">{{modeText}}</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop" wx:if="{{stageImage || stageVideo}}">
      <image wx:if="{{stageImage}}" class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <video
        wx:if="{{stageVideo}}"
        id="scene-backdrop-video"
        class="scene-backdrop-video"
        src="{{stageVideo}}"
        poster="{{stageImage}}"
        autoplay
        muted
        loop
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        show-fullscreen-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        object-fit="cover"
      ></video>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask"></view>
    </view>

    <view class="scene-layer">
      <view class="room-hero">
        <view class="room-heading">
          <view class="big-title">{{stageName}}</view>
          <view class="room-hint">{{roomHintText}}</view>
        </view>
        <view class="tags">
          <text class="tag">房间 #{{roomId}}</text>
          <text class="tag">{{modeText}}</text>
        </view>
      </view>

      <view class="slot-grid">
        <view class="slot {{item.filled?'filled':'empty'}}" wx:for="{{slots}}" wx:key="index">
          <image class="avatar" wx:if="{{item.filled}}" src="{{item.avatar || defaultAvatar}}" mode="aspectFill" lazy-load="{{true}}"></image>
          <button wx:else class="empty-avatar slot-invite-btn" open-type="{{backendRoomId && shareEnabled ? 'share' : ''}}" bindtap="inviteFriend" loading="{{creatingOnlineRoom}}" disabled="{{starting || creatingOnlineRoom || !shareEnabled}}" aria-label="{{backendRoomId ? '选择微信群或好友发送房间邀请' : '创建联网房间邀请好友'}}" hover-class="btn-hover"><view class="invite-plus" aria-hidden="true"></view></button>
          <view class="slot-name">{{item.name}}</view>
          <view class="slot-state" wx:if="{{item.state}}">• {{item.state}}</view>
          <view class="star" wx:if="{{item.star}}">★</view>
        </view>
      </view>

      <view class="voice-box">
        <view class="voice-line">
          <text class="voice-title">房间人数</text>
          <text class="percent">{{activePercent}}%</text>
        </view>
        <view class="track"><view class="bar" style="width: {{activePercent}}%;"></view></view>
      </view>

      <view class="bottom-actions">
        <button class="start-btn {{backendRoomId && !isHost ? 'start-btn-disabled' : ''}}" bindtap="start" disabled="{{starting || creatingOnlineRoom || (backendRoomId && !isHost)}}" hover-class="btn-hover">
          <text class="btn-icon">▶</text>
          <text>{{backendRoomId && !isHost ? '等待房主开始' : startButtonText}}</text>
        </button>
        <view class="invite-hint">
          <text class="invite-hint-icon">邀</text>
          <text>{{!shareEnabled ? '邀请分享暂未开放' : backendRoomId ? '点击＋，选择微信群或好友发送邀请' : '点击＋创建好友房，建好后即可分享邀请'}}</text>
        </view>
        <view class="secondary-actions">
          <button class="primary-btn invite-btn" open-type="{{backendRoomId && shareEnabled ? 'share' : ''}}" bindtap="inviteFriend" loading="{{creatingOnlineRoom}}" disabled="{{starting || creatingOnlineRoom || !shareEnabled}}" aria-label="{{backendRoomId ? '选择微信群或好友发送房间邀请' : '创建联网房间邀请好友'}}" hover-class="btn-hover">
            <view class="invite-plus" aria-hidden="true"></view>
            <text>{{creatingOnlineRoom ? '创建中' : backendRoomId ? '选择微信群' : '创建好友房'}}</text>
          </button>
          <button class="ready-btn" bindtap="toggleReady" disabled="{{starting || creatingOnlineRoom}}" hover-class="btn-hover">
            <text class="btn-icon">{{selfReady ? '✓' : '○'}}</text>
            <text>{{selfReady ? '取消准备' : '准备'}}</text>
          </button>
        </view>
      </view>

      <view class="bottom-nav">
        <view wx:for="{{ tabs }}" wx:key="key" class="nav-item {{ activeTab === item.key ? 'active' : '' }}" data-page="{{ item.page }}" bindtap="switchTab" hover-class="clickable-hover">
          <view class="nav-dot"><image class="nav-icon" src="{{activeTab===item.key ? item.iconActive : item.icon}}" mode="aspectFit"></image></view>
          <text>{{ item.label }}</text>
        </view>
      </view>
    </view>

    <view class="guide-overlay guide-room" wx:if="{{guideVisible}}">
      <view class="guide-mask"></view>
      <view class="guide-card guide-card-middle">
        <view class="guide-kicker">新手引导 2/5</view>
        <view class="guide-title">准备好后开局，系统会补足体验玩家</view>
      </view>
      <view class="guide-action-panel">
        <button class="guide-primary" bindtap="onGuidePrimary" hover-class="btn-hover">开始游戏</button>
      </view>
    </view>
  </view>
</view>
