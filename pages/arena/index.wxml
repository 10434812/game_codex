<view class="paper-bg arena-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/gamebg-compressed.png" mode="scaleToFill"></image>
  <view class="app-header" style="padding-top: {{ nav.statusBarHeight }}px; padding-right: {{ nav.capsuleSpace }}px;">
    <view class="app-user" bindtap="onTapProfile" hover-class="clickable-hover">
      <image wx:if="{{userProfile.avatarUrl}}" class="app-user-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
      <image wx:else class="app-user-avatar" src="{{defaultAvatar}}" mode="aspectFill"></image>
      <text class="app-user-name">{{userProfile.nickName}}</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-dot">●</text>
        <text class="app-status-text">{{modeText}}</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop" wx:if="{{stageImage}}">
      <image class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask arena-scene-mask"></view>
    </view>

    <view class="scene-layer">
    <button class="rules-entry" size="mini" bindtap="onOpenRules" hover-class="btn-hover">玩法</button>
    <view class="timer card {{sprint ? 'timer-sprint' : ''}}">
      <view class="time">{{timeText}}</view>
      <view class="self-rank {{selfRankLead ? 'self-rank-lead' : ''}}" wx:if="{{selfRankText}}">{{selfRankText}}</view>
      <view class="hint" wx:if="{{!sprint}}">{{hint}}</view>
      <view class="hint sprint-hint" wx:else>最后 15 秒 · 冲刺！<text>{{sprintText}}</text></view>
    </view>

    <view class="run-team-bar">
      <text class="run-team-copy">{{teamText}}</text><button wx:if="{{hasTeam}}" bindtap="onExitTeam" disabled="{{teamPending}}">退出组队</button>
      <button wx:if="{{waiting && !rulesVisible}}" bindtap="cancelStart">取消本次开局</button>
      <view class="run-invite-prompt" wx:if="{{incomingId && !waiting}}">
        <text class="run-invite-copy">{{incomingName}} 邀请你组队</text>
        <button class="run-invite-accept" bindtap="onAcceptInvite" disabled="{{teamPending}}">接受</button>
        <button class="run-invite-ignore" bindtap="onIgnoreInvite" disabled="{{teamPending}}">忽略</button>
      </view>
    </view>
    <view class="run-action-error" wx:if="{{error}}">{{error}}</view>
    <view class="run-action-error" wx:if="{{connectionText}}">{{connectionText}}</view>
    <view class="run-tutorial" wx:if="{{tutorialStep && !rulesVisible && !waiting}}">
      <text>{{tutorialStep === 1 ? '拖动手指移动，松手停下' : tutorialStep === 2 ? '接福袋和礼物加分，绕开地雷' : '想组队时，点选其他玩家发出邀请'}}</text>
      <button bindtap="dismissTutorial">知道了</button>
    </view>
    <view class="board" id="run-field" style="--arena-move-time:{{motionDuration}}ms;" catchtouchstart="onRunTouchStart" catchtouchmove="onRunTouchMove" catchtouchend="onRunTouchEnd" catchtouchcancel="onRunTouchCancel">
      <view class="link-layer">
        <view class="link team-link" wx:for="{{ teamLinks }}" wx:key="id" style="{{ item.style }}"></view>
        <view class="link invite-link" wx:if="{{ inviteLink }}" style="{{ inviteLink.style }}"></view>
        <view class="link success-link" wx:if="{{ successLink }}" style="{{ successLink.style }}"></view>
      </view>

      <view class="run-drop {{item.warning ? 'run-drop-warning' : ''}} run-drop-{{item.kind}}" wx:for="{{drops}}" wx:key="id" style="transform:translate3d({{item.px}}px,{{item.py}}px,0) translate(-50%,-50%);">
        <image wx:if="{{item.asset}}" class="run-drop-image" src="{{item.asset}}" mode="aspectFit" />
        <view wx:else class="run-drop-glyph">{{item.glyph}}</view>
        <text class="run-drop-label">{{item.label}}</text>
      </view>
      <view class="run-impact run-impact-{{item.kind}}" wx:for="{{bursts}}" wx:key="id" wx:if="{{item.effect}}" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.effect.size}}rpx;height:{{item.effect.size}}rpx;opacity:{{item.effect.opacity}};">
        <image class="run-impact-atlas" src="{{item.effect.asset}}" mode="scaleToFill" style="transform:translate3d({{item.effect.offsetX}}%,{{item.effect.offsetY}}%,0);" />
      </view>
      <view class="run-burst {{item.loss ? 'run-burst-loss' : ''}}" wx:for="{{bursts}}" wx:key="id" style="left:{{item.labelX}}%;top:{{item.labelY}}%;"><view wx:if="{{item.team}}" /><text>{{item.text}}</text></view>
      <view class="team-success-toast" wx:if="{{ successToast }}" style="left: {{ successToast.x }}rpx; top: {{ successToast.y }}rpx;">
        {{ successToast.text }}
      </view>

      <view class="runner-position {{item.isSelf ? 'self-runner-position' : ''}}" wx:for="{{ players }}" wx:key="id" style="transform:translate3d({{item.px}}px,{{item.py}}px,0);">
      <view class="player-node {{ item.isSelf ? 'self-node' : '' }}" data-player-id="{{ item.id }}" catchtouchstart="onRunTouchStart">
        <view class="avatar-shell {{ item.isSelf ? 'self-avatar-shell' : '' }} {{ item.skinClass }} {{item.invited ? 'run-invited' : ''}} {{item.boosted ? 'run-boosted' : ''}} {{item.shield ? 'run-shielded' : ''}} {{item.magnet ? 'run-magnet' : ''}}" hover-class="clickable-hover">
          <view class="avatar-core">
            <image class="avatar" src="{{ item.skinImage || item.avatar || 'https://xcx.ukb88.com/assets/bg/avatars/avatar_01.png' }}" mode="aspectFill" lazy-load="{{true}}"></image>
          </view>
          <image wx:if="{{ item.isSelf && item.ringImage }}" class="avatar-ring-overlay" src="{{ item.ringImage }}" mode="aspectFit" lazy-load="{{true}}"></image>
        </view>
        <view
          class="pet-follower"
          wx:if="{{ item.isSelf && item.petLabel }}"
        >
          <view class="pet-avatar-shell" style="background: linear-gradient(145deg, #fff8ec 0%, {{ item.petAccent || '#d8a062' }} 100%);">
            <image wx:if="{{ item.petImage }}" class="pet-avatar" src="{{ item.petImage }}" mode="aspectFill" lazy-load="{{true}}"></image>
            <text wx:else class="pet-emoji">{{ item.petIcon }}</text>
          </view>
        </view>
        <view class="score-visible-tag" wx:if="{{ item.showScore && !item.isSelf }}">
          <view class="score-visible-blood">
            <view class="score-visible-blood-fill" style="width: {{ item.revealHpPercent }}%;"></view>
          </view>
        </view>
        <view class="emote-bubble emote-{{ item.chatPos || 'upper-center' }}" wx:if="{{ item.emoteText }}">{{ item.emoteText }}</view>
      </view>
      </view>

      <view class="player-name-layer">
        <view class="run-label-anchor {{item.isSelf ? 'self-run-label' : ''}}" wx:for="{{ players }}" wx:key="id" style="transform:translate3d({{item.labelX}}px,{{item.labelY}}px,0);">
          <view class="node-name run-name {{ item.isSelf ? 'self-node-name' : '' }}" style="width:{{item.labelWidth}}px;">{{ item.scoreLabel }}</view>
        </view>
      </view>
    </view>

    <view class="quick-emote-panel" wx:if="{{ emotePanelVisible }}" style="bottom: calc({{ messageCardCollapsed ? 388 : 484 }}rpx + env(safe-area-inset-bottom));">
      <view
        class="quick-emote-item"
        wx:for="{{ quickEmotes }}"
        wx:key="key"
        data-key="{{ item.key }}"
        bindtap="onSendQuickEmote"
        hover-class="clickable-hover"
      >
        {{ item.label }}
      </view>
    </view>

    <view class="message-reply-card {{ messageCardCollapsed ? 'collapsed' : '' }}">
      <view class="message-reply-head" bindtap="onToggleMessageCard">
        <view class="message-reply-title">消息回复</view>
        <view class="message-reply-toggle">{{ messageCardCollapsed ? '展开' : '收起' }}</view>
      </view>
      <scroll-view wx:if="{{ !messageCardCollapsed }}" class="message-reply-list" scroll-y="{{true}}">
        <view wx:if="{{!chatMessages.length}}" class="message-empty">点击右侧按钮发送快捷回复</view>
        <view wx:for="{{ chatMessages }}" wx:key="id" class="message-item {{ item.isSelf ? 'self' : '' }}">
          <text class="message-name">{{item.sender}}：</text>
          <text class="message-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <view class="quick-reply-row">
        <view
          class="quick-reply-chip"
          wx:for="{{quickReplyOptions}}"
          wx:key="key"
          data-key="{{ item.key }}"
          bindtap="onSendQuickEmote"
          hover-class="clickable-hover"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="quick-emote" style="bottom: calc({{ messageCardCollapsed ? 286 : 382 }}rpx + env(safe-area-inset-bottom));" bindtap="onToggleEmotePanel" hover-class="clickable-hover">☺</view>

    <view class="bottom-nav {{navExpanded ? 'expanded' : 'collapsed'}}">
      <block wx:if="{{navExpanded}}">
        <view wx:for="{{ tabs }}" wx:key="key" class="nav-item {{ activeTab === item.key ? 'active' : '' }}" data-page="{{ item.page }}" bindtap="switchTab" hover-class="clickable-hover">
          <view class="nav-dot"><image class="nav-icon" src="{{activeTab===item.key ? item.iconActive : item.icon}}" mode="aspectFit"></image></view>
          <text>{{ item.label }}</text>
        </view>
      </block>
      <view class="nav-toggle" catchtap="toggleNav" hover-class="clickable-hover" aria-role="button" aria-label="{{navExpanded ? '收起导航' : '展开导航'}}"><view class="nav-toggle-arrow"></view></view>
    </view>
    </view>

    <view class="rules-overlay" wx:if="{{rulesVisible}}" catchtouchmove="noop">
      <view class="rules-panel">
        <view class="rules-title">120 秒，争夺积分第一！</view>
        <view class="rules-summary">统一 100 分开局。拖动跑动，松手停住。接住福袋和礼物，躲开雷，按个人积分排名。</view>
        <view class="rules-item"><text class="rules-label">组队联动</text><text>双方互相点选同意，追上碰面后成队并闪爆。靠近队友双方加速。</text></view>
        <view class="rules-item"><text class="rules-label">保持独立</text><text>点击退出组队即可随时离队，恢复各自得分。</text></view>
        <view class="rules-item"><text class="rules-label">道具护航</text><text>护盾挡一次雷；磁铁持续 6 秒，吸附附近好运。</text></view>
        <view class="rules-item"><text class="rules-label">争取高分</text><text>福袋 +10，礼物 +20，雷 −10；连击加分最多 +10，最后 15 秒正向基础分翻倍。队友同步一半。</text></view>
        <view class="rules-note">{{rulesFirstRun ? '点击开始后计时；联机对局等待所有玩家确认。' : '本局继续计时，可随时回到对局调整策略。'}}</view>
        <button class="rules-primary" bindtap="onStartFromRules" loading="{{rulesStarting}}" disabled="{{rulesStarting}}" hover-class="btn-hover">{{rulesFirstRun ? '开始' : '返回对局'}}</button>
      </view>
    </view>
  </view>
</view>
