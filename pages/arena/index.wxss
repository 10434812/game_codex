.run-team-bar { flex-shrink:0; height:48rpx; display:flex; align-items:center; justify-content:center; gap:18rpx; color:#fff4dc; font-size:23rpx; text-shadow:0 2rpx 6rpx #21170d; }
.run-team-bar button { margin:0; padding:0 16rpx; font-size:22rpx; line-height:42rpx; color:var(--stage-ink); background:var(--stage-panel-solid); border-radius:999rpx; }
.run-team-bar { position:relative; z-index:20; width:690rpx; max-width:92%; margin:0 auto; }
.run-team-copy { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.run-action-error { color:#fff0dc; text-align:center; font-size:24rpx; padding:4rpx 20rpx; }
.run-tutorial { display:flex; align-items:center; justify-content:center; gap:12rpx; margin:4rpx 20rpx; color:#fff8ea; font-size:23rpx; line-height:1.4; }
.run-tutorial button { flex-shrink:0; margin:0; padding:0 14rpx; color:#4a2f17; background:#fff8ea; font-size:22rpx; line-height:48rpx; }
.run-invite-prompt { position:absolute; top:100%; left:0; right:0; box-sizing:border-box; margin-top:8rpx; display:flex; align-items:center; gap:12rpx; padding:12rpx 16rpx; border-radius:16rpx; background:var(--stage-panel-solid,#fff3db); color:var(--stage-ink,#4a2f17); text-shadow:none; box-shadow:0 8rpx 20rpx rgba(30,20,10,.24); }
.run-invite-copy { flex:1; min-width:0; font-size:24rpx; line-height:32rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.run-invite-prompt button { flex:none; width:100rpx; box-sizing:border-box; margin:0; padding:0 12rpx; min-height:72rpx; line-height:72rpx; font-size:24rpx; border-radius:12rpx; }
.run-invite-prompt .run-invite-accept { color:#fff8e9; background:#80451d; }
.run-invite-prompt .run-invite-ignore { color:#60401f; background:#f2dfb9; }
.timer-sprint { border-color:#a63c21; }
.timer-sprint .time { color:#8e2b19; animation:sprint-beat 1s ease-out infinite; }
.sprint-hint { font-size:22rpx; line-height:29rpx; color:#772714; }
.sprint-hint text { display:block; font-size:21rpx; }
.run-burst.run-burst-loss { color:#a13323; border-color:#d68c6c; background:#fff0df; }
@keyframes sprint-beat { 0% {transform:scale(1.04);} 45%,100% {transform:scale(1);} }
.runner-position { position:absolute; left:0; top:0; width:0; height:0; z-index:4; will-change:transform; }
.self-runner-position { z-index:6; }
.runner-position,.run-drop,.run-label-anchor { transition:transform var(--arena-move-time,16ms) linear; }
.self-runner-position,.self-run-label { transition:none; }
.run-drop { position:absolute; left:0; top:0; width:128rpx; height:128rpx; z-index:3; pointer-events:none; will-change:transform; }
.run-drop-image { width:100%; height:100%; }
.run-drop-label { position:absolute; bottom:-24rpx; left:50%; transform:translateX(-50%); color:#fff4dc; font-size:24rpx; font-weight:700; white-space:nowrap; text-shadow:0 2rpx 6rpx #23170a; }
.run-drop-warning { opacity:.8; animation:invitePulse .4s ease-in-out infinite alternate; }
.run-drop-warning .run-drop-image { opacity:.45; transform:scale(.6); }
.run-invited { outline:5rpx dashed #ffe0a0; outline-offset:8rpx; }
.run-boosted { box-shadow:0 0 30rpx #ffda77,0 0 60rpx #f7ac4266; }
.run-burst { position:absolute; z-index:12; pointer-events:none; transform:translate(-50%,-50%); padding:8rpx 16rpx; border:2rpx solid #e1bc75; border-radius:12rpx; background:#fff7e6; color:#27634f; font-size:28rpx; line-height:34rpx; font-weight:800; white-space:nowrap; box-shadow:0 4rpx 12rpx rgba(35,23,10,.2); animation:run-burst-fade 1s ease-out both; }
.run-burst view { position:absolute; width:150rpx; height:150rpx; left:50%; top:50%; border:6rpx solid #ffe3a3; border-radius:50%; box-shadow:0 0 30rpx #ffc75f,inset 0 0 25rpx #ffc75f; transform:translate(-50%,-50%); animation:run-burst-ring 1s ease-out both; }
.run-label-anchor {position:absolute;left:0;top:0;width:0;height:0;}
.self-run-label {z-index:1;}
.node-name.run-name {top:0;min-width:0;max-width:220rpx;height:36rpx;line-height:36rpx;font-size:21rpx;padding:0 10rpx;}
@keyframes run-burst-fade { from {opacity:1;transform:translate(-50%,-50%) translateY(0);} 55% {opacity:1;} to {opacity:0;transform:translate(-50%,-50%) translateY(-32rpx);} }
@keyframes run-burst-ring { from {transform:translate(-50%,-50%) scale(.3);} to {transform:translate(-50%,-50%) scale(2);opacity:0;} }

.run-impact { position:absolute; z-index:3; pointer-events:none; overflow:hidden; transform:translate(-50%,-50%); }
.run-impact-atlas { position:absolute; left:0; top:0; width:400%; height:200%; max-width:none; }
@media (prefers-reduced-motion:reduce) {
  .run-impact { transform:translate(-50%,-50%) scale(.75); }
  .run-burst { animation-name:run-impact-fade; transform:translate(-50%,-50%) translateY(0); }
}
@keyframes run-impact-fade { from {opacity:1;} to {opacity:0;} }
