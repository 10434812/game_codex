.arena-page {
  padding: 8rpx 0 188rpx;
}

.page-content {
  position: relative;
  padding-top: 6rpx;
}

.arena-page .scene-backdrop-video {
  opacity: 0.9;
  transform: scale(1.08);
  filter: blur(9rpx) saturate(0.96) brightness(0.86);
}

.arena-page .scene-backdrop-image {
  transform: scale(1.09);
  filter: blur(11rpx) saturate(0.96) brightness(0.86);
}

.arena-scene-mask {
  -webkit-backdrop-filter: blur(3rpx) saturate(1);
  backdrop-filter: blur(3rpx) saturate(1);
  background:
    radial-gradient(circle at 50% 24%, var(--stage-wash, rgba(255, 196, 109, 0.12)) 0%, transparent 28%),
    radial-gradient(ellipse at 50% 54%, rgba(3, 8, 18, 0.08) 0%, rgba(3, 8, 18, 0.28) 74%),
    linear-gradient(180deg, rgba(3, 8, 18, 0.22) 0%, rgba(5, 12, 24, 0.32) 42%, rgba(10, 8, 8, 0.48) 100%),
    linear-gradient(90deg, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.03) 18%, rgba(0, 0, 0, 0.04) 82%, rgba(0, 0, 0, 0.24) 100%);
}

.arena-page .scene-template {
  opacity: 0.24;
  background:
    radial-gradient(circle at 50% 20%, var(--stage-glow, rgba(255, 196, 109, 0.18)) 0%, transparent 28%),
    linear-gradient(135deg, transparent 0%, transparent 46%, rgba(255, 255, 255, 0.04) 46%, rgba(255, 255, 255, 0.04) 47%, transparent 47%, transparent 100%);
  background-size: auto, 160rpx 160rpx;
}

.timer {
  width: 372rpx;
  margin: 12rpx auto 8rpx;
  height: 240rpx;
  box-sizing: border-box;
  border-radius: 78rpx;
  text-align: center;
  padding: 20rpx 20rpx 18rpx;
  background: linear-gradient(180deg, var(--stage-soft, #d9bc86) 0%, var(--stage-primary, #cba56b) 100%);
  border: 4rpx solid var(--stage-border, #b48d54);
  box-shadow: 0 16rpx 32rpx var(--stage-shadow, rgba(118, 84, 38, 0.2));
  backdrop-filter: blur(10rpx);
  animation: timer-land 0.5s ease-out both;
}

.time {
  font-size: 102rpx;
  line-height: 1;
  font-weight: 900;
  color: var(--stage-ink, #4a2f17);
  text-shadow: 0 3rpx 0 rgba(255, 238, 197, 0.6);
}

.hint {
  margin-top: 6rpx;
  height: 72rpx;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: var(--stage-deep, #6c4a23);
  overflow: hidden;
  word-break: break-all;
}

.board {
  position: relative;
  margin: 0 auto;
  width: 720rpx;
  height: 900rpx;
}

.link-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.link {
  position: absolute;
  height: 6rpx;
  border-radius: 999rpx;
  transform-origin: center;
}

.team-link {
  background: linear-gradient(90deg, var(--stage-border, rgba(190, 152, 91, 0.7)), var(--stage-primary, rgba(176, 135, 71, 0.7)));
  opacity: 0.78;
}

.invite-link {
  background: linear-gradient(90deg, var(--stage-bright, rgba(241, 173, 72, 0.9)), var(--stage-primary, rgba(229, 111, 63, 0.9)));
  border: 2rpx dashed rgba(255, 231, 193, 0.7);
  box-shadow: 0 0 16rpx var(--stage-glow, rgba(232, 139, 71, 0.35));
  animation: invitePulse 0.6s ease-in-out infinite alternate;
}

.success-link {
  height: 8rpx;
  background: linear-gradient(90deg, var(--stage-bright, rgba(245, 180, 70, 0.95)), var(--stage-primary, rgba(230, 122, 31, 0.95)));
  box-shadow: 0 0 22rpx var(--stage-glow, rgba(233, 137, 42, 0.55));
  animation: successFlash 0.28s ease-in-out 4;
}

.fortune-bag-wrap {
  position: absolute;
  width: 352rpx;
  height: 404rpx;
  transform: translate(-50%, -50%);
  z-index: 3;
  animation: bagSummonIn 0.78s cubic-bezier(0.18, 0.9, 0.26, 1.18) forwards, bagHover 1.86s ease-in-out 0.78s infinite;
}

.fortune-bag-stage {
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  transform: translateX(-50%);
}

.fortune-bag-image {
  position: absolute;
  top: -36rpx;
  left: -36rpx;
  width: 352rpx;
  height: 352rpx;
  z-index: 3;
  filter: drop-shadow(0 16rpx 28rpx rgba(166, 84, 24, 0.22));
}

.fortune-bag-halo {
  position: absolute;
  top: 36rpx;
  left: 36rpx;
  width: 208rpx;
  height: 208rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, rgba(255, 247, 214, 0.82) 0%, rgba(255, 224, 143, 0.24) 42%, rgba(255, 196, 109, 0.03) 70%, transparent 100%);
  filter: blur(4rpx);
  animation: bagHaloPulse 1.28s ease-in-out infinite;
}

.fortune-bag-spotlight {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 244rpx;
  height: 236rpx;
  transform: translateX(-50%) scaleY(1.08);
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 24%, rgba(255, 240, 192, 0.42) 0%, rgba(255, 220, 126, 0.14) 38%, rgba(255, 220, 126, 0.02) 66%, transparent 100%);
  filter: blur(6rpx);
  opacity: 0.56;
  animation: bagSpotlightGlow 1.5s ease-in-out infinite;
}

.fortune-bag-trail {
  position: absolute;
  top: -100rpx;
  left: 50%;
  width: 24rpx;
  height: 152rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 251, 234, 0) 0%, rgba(255, 248, 214, 0.66) 42%, rgba(255, 213, 117, 0.12) 100%);
  filter: blur(4rpx);
  animation: bagTrailFall 0.88s cubic-bezier(0.2, 0.9, 0.3, 1) both;
}

.fortune-bag-ripple {
  position: absolute;
  left: 50%;
  top: 140rpx;
  width: 208rpx;
  height: 208rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 228, 159, 0.6);
  transform: translateX(-50%);
  opacity: 0;
}

.fortune-bag-ripple.ripple-one {
  animation: bagRipple 1.6s ease-out 0.2s infinite;
}

.fortune-bag-ripple.ripple-two {
  animation: bagRipple 1.6s ease-out 0.8s infinite;
}

.fortune-bag-spark {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, rgba(255, 252, 238, 1) 0%, rgba(255, 210, 122, 0.94) 58%, rgba(255, 210, 122, 0) 100%);
  box-shadow: 0 0 24rpx rgba(255, 205, 103, 0.68);
}

.fortune-bag-spark.spark-left {
  top: 152rpx;
  left: 40rpx;
  animation: bagSparkFloatLeft 1.36s ease-in-out infinite;
}

.fortune-bag-spark.spark-right {
  top: 168rpx;
  right: 40rpx;
  animation: bagSparkFloatRight 1.18s ease-in-out 0.24s infinite;
}

.fortune-bag-spark.spark-bottom {
  top: 308rpx;
  left: 162rpx;
  width: 28rpx;
  height: 28rpx;
  animation: bagSparkFloatBottom 1.48s ease-in-out 0.12s infinite;
}

.fortune-bag-countdown {
  position: absolute;
  top: 344rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 96rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 241, 0.96);
  border: 2rpx solid var(--stage-border, rgba(182, 137, 71, 0.72));
  color: var(--stage-deep, #8a5f2b);
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 8rpx 16rpx var(--stage-shadow, rgba(153, 112, 58, 0.18));
}

.player-node {
  position: absolute;
  width: 126rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 4;
  animation: player-drop-in 0.46s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.player-node:nth-child(2n) {
  animation-delay: 0.05s;
}

.player-node:nth-child(3n) {
  animation-delay: 0.1s;
}

.self-node {
  z-index: 6;
}

.player-name-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 8;
}

.player-label-anchor {
  position: absolute;
  width: 126rpx;
  transform: translateX(-50%);
}

.avatar-shell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  padding: var(--avatar-ring-padding, 3rpx);
  border-radius: 50%;
  overflow: visible;
  background: linear-gradient(145deg, var(--avatar-ring-bg-start, #ffd45f) 0%, var(--avatar-ring-bg-end, #f1a91f) 100%);
  box-shadow: var(--avatar-ring-shadow, 0 6rpx 14rpx rgba(145, 98, 27, 0.18));
}

.self-avatar-shell {
  background: linear-gradient(145deg, var(--stage-bright, #ffdd78) 0%, var(--stage-primary, #f09529) 100%);
  box-shadow: 0 0 0 3rpx var(--stage-glow, rgba(255, 223, 136, 0.36)), 0 8rpx 18rpx var(--stage-shadow, rgba(188, 101, 33, 0.28));
  animation: self-avatar-pulse 2s ease-in-out infinite;
}

.avatar-shell.skin-default.self-avatar-shell {
  background: linear-gradient(145deg, var(--stage-bright, #ffdd78) 0%, var(--stage-primary, #f09529) 100%);
}

.avatar-shell.skin-sakura.self-avatar-shell {
  background: linear-gradient(145deg, #ffd1de 0%, #db6b91 100%);
  box-shadow: 0 0 0 3rpx rgba(255, 214, 227, 0.36), 0 8rpx 18rpx rgba(200, 92, 126, 0.26);
}

.avatar-shell.skin-storm.self-avatar-shell {
  background: linear-gradient(145deg, #adc3ff 0%, #4968d1 100%);
  box-shadow: 0 0 0 3rpx rgba(182, 202, 255, 0.34), 0 8rpx 18rpx rgba(66, 96, 189, 0.28);
}

.avatar-shell.skin-sunrise.self-avatar-shell {
  background: linear-gradient(145deg, #ffd47d 0%, #ea7b2c 100%);
  box-shadow: 0 0 0 3rpx rgba(255, 219, 154, 0.36), 0 8rpx 18rpx rgba(210, 112, 35, 0.26);
}

.avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 0;
  box-sizing: border-box;
}

.avatar-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.avatar-ring-overlay {
  position: absolute;
  inset: -18rpx;
  width: auto;
  height: auto;
  z-index: 2;
  pointer-events: none;
  animation: ring-sparkle 4.8s linear 1;
}

.emote-bubble {
  position: absolute;
  top: -60rpx;
  min-width: 96rpx;
  max-width: 240rpx;
  min-height: 40rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 245, 0.95);
  border: 2rpx solid var(--stage-border, rgba(204, 171, 116, 0.72));
  color: var(--stage-ink, #704727);
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx var(--stage-shadow, rgba(124, 92, 50, 0.22));
  white-space: nowrap;
  word-break: keep-all;
  z-index: 7;
  animation: emote-pop 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.emote-bubble.emote-upper-center {
  left: 50%;
  transform: translateX(-50%);
}

.emote-bubble.emote-upper-left,
.emote-bubble.emote-left {
  left: 0;
  transform: translate(-6rpx, 0);
}

.emote-bubble.emote-upper-right,
.emote-bubble.emote-right {
  right: 0;
  transform: translate(6rpx, 0);
}

.node-name {
  position: absolute;
  top: 128rpx;
  left: 50%;
  transform: translateX(-50%);
  min-width: 142rpx;
  max-width: 218rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: var(--stage-deep, #b38643);
  color: #fff4dc;
  font-weight: 700;
  font-size: 23rpx;
  line-height: 42rpx;
  text-align: center;
  padding: 0 18rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 4rpx 10rpx var(--stage-shadow, rgba(132, 89, 30, 0.2));
  box-sizing: border-box;
}

.node-name.name-left {
  left: auto;
  right: 0;
  transform: none;
}

.node-name.name-right {
  left: 0;
  transform: none;
}

.node-name.name-upper-center {
  top: -46rpx;
}

.node-name.name-upper-left {
  top: -42rpx;
  left: auto;
  right: 0;
  transform: none;
}

.node-name.name-upper-right {
  top: -42rpx;
  left: 0;
  transform: none;
}

.node-name.name-lower-center {
  top: 130rpx;
}

.node-name.name-lower-left {
  top: 124rpx;
  left: auto;
  right: -10rpx;
  transform: none;
  max-width: 188rpx;
}

.node-name.name-lower-right {
  top: 124rpx;
  left: -10rpx;
  transform: none;
  max-width: 188rpx;
}

.self-node-name {
  background: var(--stage-primary, #d14e42);
  color: #fff9ec;
}

.pet-follower {
  position: absolute;
  top: -8rpx;
  left: 108rpx;
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 6;
  animation: petFloat 2.6s ease-in-out infinite;
}

.pet-avatar-shell {
  width: 58rpx;
  height: 58rpx;
  padding: 3rpx;
  box-sizing: border-box;
  border-radius: 50%;
  box-shadow: 0 8rpx 14rpx rgba(130, 87, 36, 0.18);
}

.pet-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 250, 240, 0.9);
}

.pet-emoji {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 250, 240, 0.9);
  text-align: center;
  line-height: 52rpx;
  font-size: 30rpx;
}

.score-visible-tag {
  position: absolute;
  top: -12rpx;
  right: -18rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(250, 243, 228, 0.95);
  border: 2rpx solid var(--stage-border, rgba(202, 170, 117, 0.75));
  box-shadow: 0 4rpx 10rpx var(--stage-shadow, rgba(122, 92, 50, 0.2));
}

.score-visible-blood {
  width: 54rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(98, 39, 33, 0.35);
  overflow: hidden;
}

.score-visible-blood-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--stage-bright, #f5bc60) 0%, var(--stage-primary, #e57c1f) 100%);
  box-shadow: 0 0 10rpx var(--stage-glow, rgba(233, 137, 42, 0.28));
  transition: width 0.32s ease;
}

.team-success-toast {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 160rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 18rpx;
  text-align: center;
  color: #fff7e7;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--stage-bright, #f5bc60), var(--stage-primary, #e57c1f));
  box-shadow: 0 10rpx 20rpx var(--stage-glow, rgba(179, 101, 24, 0.34));
  z-index: 5;
  animation: toastPop 1.2s ease-out forwards;
}

.invest-panel {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 176rpx;
  min-height: 400rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  z-index: 30;
  display: block;
}

.fortune-panel {
  padding-bottom: 24rpx;
}

.fortune-scroll-paper {
  position: relative;
  min-height: 332rpx;
  padding: 52rpx 42rpx 38rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 242, 205, 0.9) 0%, rgba(255, 250, 241, 0) 32%),
    linear-gradient(180deg, rgba(255, 247, 229, 0.98) 0%, rgba(244, 229, 194, 0.98) 52%, rgba(236, 214, 170, 0.98) 100%);
  border: 2rpx solid rgba(181, 135, 75, 0.3);
  box-shadow:
    0 24rpx 54rpx rgba(33, 20, 9, 0.24),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.82),
    inset 0 -8rpx 16rpx rgba(171, 123, 65, 0.14);
  overflow: hidden;
  transform-origin: center;
}

.fortune-scroll-seal {
  width: 122rpx;
  height: 46rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(202, 84, 64, 0.94), rgba(162, 43, 31, 0.96));
  box-shadow: 0 10rpx 18rpx rgba(124, 39, 25, 0.18);
  color: #fff8e6;
  font-size: 22rpx;
  line-height: 46rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.fortune-scroll-rod {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(180deg, rgba(129, 76, 28, 0.96) 0%, rgba(187, 129, 54, 0.96) 48%, rgba(120, 68, 26, 0.98) 100%);
  box-shadow:
    0 10rpx 16rpx rgba(77, 42, 13, 0.18),
    inset 0 3rpx 4rpx rgba(255, 228, 186, 0.34),
    inset 0 -3rpx 4rpx rgba(82, 44, 17, 0.2);
  z-index: 2;
}

.fortune-scroll-rod.top {
  top: 20rpx;
}

.fortune-scroll-rod.bottom {
  bottom: 20rpx;
}

.phase-opening .fortune-scroll-paper {
  animation: scrollPaperOpen 0.42s cubic-bezier(0.18, 0.9, 0.24, 1.12) both;
}

.phase-opening .fortune-scroll-rod.top {
  animation: scrollRodTopOpen 0.42s cubic-bezier(0.18, 0.9, 0.24, 1.12) both;
}

.phase-opening .fortune-scroll-rod.bottom {
  animation: scrollRodBottomOpen 0.42s cubic-bezier(0.18, 0.9, 0.24, 1.12) both;
}

.phase-closing .fortune-scroll-paper {
  animation: scrollPaperClose 0.32s ease-in forwards;
}

.phase-closing .fortune-scroll-rod.top {
  animation: scrollRodTopClose 0.32s ease-in forwards;
}

.phase-closing .fortune-scroll-rod.bottom {
  animation: scrollRodBottomClose 0.32s ease-in forwards;
}

.phase-open .fortune-scroll-paper {
  transform: scaleY(1);
  opacity: 1;
}

.phase-open .fortune-scroll-rod.top,
.phase-open .fortune-scroll-rod.bottom {
  opacity: 1;
  transform: translateY(0);
}

.invest-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.invest-head-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 10rpx 16rpx rgba(176, 112, 46, 0.18));
}

.invest-head-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  text-align: center;
}

.invest-type {
  color: var(--stage-primary, #a3672f);
  font-size: 26rpx;
  font-weight: 800;
}

.invest-risk {
  color: var(--stage-deep, #8f6a3f);
  font-size: 22rpx;
  margin-top: 4rpx;
}

.invest-title {
  margin-top: 18rpx;
  color: var(--stage-ink, #4f2f1f);
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.fortune-panel .invest-line {
  display: block;
}

.invest-line {
  margin-top: 10rpx;
  color: var(--stage-deep, #6d4a28);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.invest-line.pos {
  color: var(--stage-primary, #c64a3d);
}

.invest-line.neg {
  color: var(--stage-deep, #7a5c34);
}

.invest-highlight {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--stage-primary, #e53935);
}

.invest-summary {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--stage-deep, #8b7355);
}

.invest-actions {
  margin-top: 26rpx;
  padding-top: 12rpx;
  display: flex;
  gap: 14rpx;
}

.invest-btn {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0;
}

.invest-btn::after {
  border: none;
}

.invest-btn.ghost {
  color: var(--stage-deep, #6a4b2a);
  background:
    radial-gradient(circle at 26% 18%, rgba(255, 255, 255, 0.58), transparent 34%),
    linear-gradient(135deg, rgba(255, 238, 196, 0.68), var(--stage-chip, rgba(240, 213, 167, 0.54)));
  border: 1rpx solid rgba(255, 255, 255, 0.34);
}

.quick-emote {
  position: fixed;
  right: 24rpx;
  bottom: 382rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--stage-border, rgba(255, 238, 199, 0.42));
  background:
    radial-gradient(circle at 32% 18%, rgba(255, 255, 255, 0.56), transparent 36%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.46), var(--stage-panel, rgba(255, 248, 232, 0.54)));
  color: var(--stage-primary, #b98745);
  font-size: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
  box-shadow: 0 18rpx 38rpx rgba(8, 12, 20, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.64);
  -webkit-backdrop-filter: blur(42rpx) saturate(1.2);
  backdrop-filter: blur(42rpx) saturate(1.2);
  animation: side-tool-pop 0.36s ease-out both;
}

.shop-entry {
  position: fixed;
  left: 24rpx;
  bottom: 382rpx;
  min-width: 116rpx;
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--stage-border, rgba(255, 238, 199, 0.42));
  background:
    radial-gradient(circle at 20% 18%, rgba(255, 255, 255, 0.54), transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.46), var(--stage-panel, rgba(255, 248, 232, 0.54)));
  color: var(--stage-deep, #9b6a32);
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  z-index: 9;
  box-sizing: border-box;
  box-shadow: 0 18rpx 38rpx rgba(8, 12, 20, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.64);
  -webkit-backdrop-filter: blur(42rpx) saturate(1.2);
  backdrop-filter: blur(42rpx) saturate(1.2);
  animation: side-tool-pop 0.36s ease-out 0.06s both;
}

.shop-entry-icon {
  font-size: 30rpx;
}

.quick-emote-panel {
  position: fixed;
  right: 24rpx;
  bottom: 484rpx;
  width: 180rpx;
  padding: 12rpx 10rpx;
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 82% 0%, var(--stage-glow, rgba(245, 188, 96, 0.24)), transparent 40%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.56), var(--stage-panel, rgba(255, 248, 232, 0.56)));
  border: 1rpx solid var(--stage-border, rgba(255, 238, 199, 0.42));
  box-shadow: 0 20rpx 42rpx rgba(8, 12, 20, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.64);
  -webkit-backdrop-filter: blur(46rpx) saturate(1.22);
  backdrop-filter: blur(46rpx) saturate(1.22);
  z-index: 28;
  animation: emote-panel-in 0.24s ease-out both;
}

.quick-emote-item {
  height: 54rpx;
  margin: 6rpx 0;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.54), transparent 34%),
    linear-gradient(135deg, rgba(255, 235, 190, 0.7), var(--stage-chip, rgba(240, 213, 167, 0.58)));
  color: var(--stage-ink, #734b25);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.message-reply-card {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 176rpx;
  border-radius: 26rpx;
  padding: 10rpx 14rpx 10rpx;
  background:
    radial-gradient(circle at 16% 0%, var(--stage-glow, rgba(245, 188, 96, 0.28)) 0%, transparent 38%),
    radial-gradient(circle at 92% 4%, rgba(255, 255, 255, 0.58) 0%, transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.58), var(--stage-panel, rgba(255, 248, 232, 0.58)));
  border: 1rpx solid var(--stage-border, rgba(255, 238, 199, 0.44));
  box-shadow:
    0 24rpx 54rpx rgba(8, 12, 20, 0.3),
    0 4rpx 14rpx var(--stage-glow, rgba(229, 124, 31, 0.14)),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
  -webkit-backdrop-filter: blur(48rpx) saturate(1.22) brightness(1.03);
  backdrop-filter: blur(48rpx) saturate(1.22) brightness(1.03);
  z-index: 26;
  transition: padding 0.22s ease, transform 0.22s ease;
  animation: panel-dock-in 0.38s ease-out 0.16s both;
}

.message-reply-card.collapsed {
  padding-top: 8rpx;
}

.message-reply-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 38rpx;
}

.message-reply-title {
  color: var(--stage-ink, #734b25);
  font-size: 24rpx;
  font-weight: 700;
}

.message-reply-toggle {
  min-width: 80rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 0;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.58), transparent 34%),
    linear-gradient(135deg, rgba(255, 230, 178, 0.72), var(--stage-chip, rgba(240, 213, 167, 0.6)));
  color: var(--stage-deep, #7e5630);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.message-reply-list {
  margin-top: 6rpx;
  height: 74rpx;
}

.message-empty {
  color: var(--stage-deep, #9b7a53);
  font-size: 22rpx;
  line-height: 36rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 4rpx;
  margin-bottom: 6rpx;
  color: var(--stage-ink, #603c21);
  font-size: 22rpx;
  line-height: 1.35;
}

.message-item.self {
  color: var(--stage-primary, #b03a35);
}

.message-name {
  font-weight: 700;
}

.message-text {
  flex: 1;
  word-break: break-all;
  white-space: normal;
}

.quick-reply-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.message-reply-card.collapsed .quick-reply-row {
  margin-top: 8rpx;
}

.quick-reply-chip {
  min-width: 88rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 28% 18%, rgba(255, 255, 255, 0.58), transparent 34%),
    linear-gradient(135deg, rgba(255, 230, 178, 0.72), var(--stage-chip, rgba(240, 213, 167, 0.6)));
  color: var(--stage-ink, #734b25);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

@keyframes invitePulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 0.95;
  }
}

@keyframes timer-land {
  from {
    opacity: 0;
    transform: translateY(-22rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes timer-breathe {
  0%, 100% {
    box-shadow: 0 16rpx 32rpx var(--stage-shadow, rgba(118, 84, 38, 0.2));
  }
  50% {
    box-shadow: 0 20rpx 42rpx var(--stage-glow, rgba(209, 126, 31, 0.28));
  }
}

@keyframes link-flow {
  from {
    background-position: 0 0;
  }
  to {
    background-position: 180% 0;
  }
}

@keyframes player-drop-in {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(22rpx) scale(0.88);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}

@keyframes avatar-idle-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-4rpx);
  }
}

@keyframes self-avatar-pulse {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-5rpx) scale(1.04);
  }
}

@keyframes ring-sparkle {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes emote-pop {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes panel-dock-in {
  from {
    opacity: 0;
    transform: translateY(34rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes side-tool-pop {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.88);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes emote-panel-in {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes bagSummonIn {
  0% {
    opacity: 0;
    transform: translate(-50%, -260rpx) scale(0.52) rotate(-10deg);
  }
  56% {
    opacity: 1;
    transform: translate(-50%, -42%) scale(1.08) rotate(5deg);
  }
  78% {
    transform: translate(-50%, -52%) scale(0.95) rotate(-2deg);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(0deg);
  }
}

@keyframes bagHover {
  0%, 100% {
    transform: translate(-50%, -50%) translateY(0);
  }
  50% {
    transform: translate(-50%, -50%) translateY(-10rpx);
  }
}

@keyframes bagTrailFall {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(-42rpx) scaleY(0.28);
  }
  48% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(12rpx) scaleY(1);
  }
}

@keyframes bagHaloPulse {
  0%, 100% {
    transform: scale(0.94);
    opacity: 0.72;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

@keyframes bagSpotlightGlow {
  0%, 100% {
    opacity: 0.62;
  }
  50% {
    opacity: 0.92;
  }
}

@keyframes bagRipple {
  0% {
    opacity: 0;
    transform: translateX(-50%) scale(0.58);
  }
  24% {
    opacity: 0.7;
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) scale(1.18);
  }
}

@keyframes bagSparkFloatLeft {
  0%, 100% {
    transform: translate3d(0, 0, 0) scale(0.92);
    opacity: 0.44;
  }
  50% {
    transform: translate3d(-8rpx, -14rpx, 0) scale(1.08);
    opacity: 1;
  }
}

@keyframes bagSparkFloatRight {
  0%, 100% {
    transform: translate3d(0, 0, 0) scale(0.88);
    opacity: 0.36;
  }
  50% {
    transform: translate3d(10rpx, -12rpx, 0) scale(1.06);
    opacity: 1;
  }
}

@keyframes bagSparkFloatBottom {
  0%, 100% {
    transform: translate3d(0, 0, 0) scale(0.82);
    opacity: 0.32;
  }
  50% {
    transform: translate3d(0, -10rpx, 0) scale(1);
    opacity: 0.9;
  }
}

@keyframes scrollPaperOpen {
  0% {
    opacity: 0.18;
    transform: scaleY(0.14);
  }
  100% {
    opacity: 1;
    transform: scaleY(1);
  }
}

@keyframes scrollPaperClose {
  0% {
    opacity: 1;
    transform: scaleY(1);
  }
  100% {
    opacity: 0.16;
    transform: scaleY(0.14);
  }
}

@keyframes scrollRodTopOpen {
  0% {
    opacity: 0.2;
    transform: translateY(150rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scrollRodBottomOpen {
  0% {
    opacity: 0.2;
    transform: translateY(-150rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scrollRodTopClose {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0.2;
    transform: translateY(150rpx);
  }
}

@keyframes scrollRodBottomClose {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0.2;
    transform: translateY(-150rpx);
  }
}

@keyframes successFlash {
  0% {
    opacity: 0.25;
    box-shadow: 0 0 8rpx rgba(240, 72, 79, 0.2);
  }
  100% {
    opacity: 1;
    box-shadow: 0 0 24rpx rgba(240, 72, 79, 0.62);
  }
}

@keyframes toastPop {
  0% {
    opacity: 0;
    transform: translate(-50%, -24rpx) scale(0.88);
  }
  22% {
    opacity: 1;
    transform: translate(-50%, -72rpx) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -118rpx) scale(0.98);
  }
}

@keyframes petFloat {
  0% {
    transform: translate3d(0, 0, 0) rotate(-2deg);
  }
  50% {
    transform: translate3d(0, -10rpx, 0) rotate(2deg);
  }
  100% {
    transform: translate3d(0, 0, 0) rotate(-2deg);
  }
}
