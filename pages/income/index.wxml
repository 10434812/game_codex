<view class="paper-bg income-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg.png" mode="scaleToFill"></image>

  <view class="app-header" style="padding-top: {{nav.statusBarHeight}}px; padding-right: {{nav.capsuleSpace}}px;">
    <view class="app-user">
      <view class="app-user-avatar">🐟</view>
      <text class="app-user-name">资金明细</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-text">历史记录</text>
      </view>
      <view class="app-gear" bindtap="onBack">←</view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop theme-page-backdrop income-scene-backdrop" wx:if="{{stageImage || stageVideo}}">
      <image wx:if="{{stageImage}}" class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <video
        wx:if="{{stageVideo}}"
        id="scene-backdrop-video"
        class="scene-backdrop-video"
        src="{{stageVideo}}"
        poster="{{stageImage}}"
        autoplay
        muted
        loop
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-play-btn="{{false}}"
        show-fullscreen-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        object-fit="cover"
      ></video>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask"></view>
    </view>

    <view class="scene-layer income-scene-layer">
    <view class="card summary-card">
      <view class="summary-main">
        <image class="currency-icon" src="https://xcx.ukb88.com/assets/icons/koi-coin.svg" mode="aspectFit"></image>
        <text class="currency-unit">锦鲤币</text>
        <text class="currency-amount">{{balanceAmountText}}</text>
      </view>
      <view class="summary-sub">{{accountLabel}}</view>
    </view>

    <view class="list-head">资金明细</view>

    <view wx:if="{{loading}}" class="empty-state">正在加载资金明细…</view>
    <view wx:elif="{{records.length}}" class="record-list">
      <view wx:for="{{records}}" wx:key="id" class="record-item">
        <view class="record-row">
          <text class="record-stage">{{item.typeText}}</text>
          <text class="record-income">{{item.amountText}}</text>
        </view>
        <view class="record-row sub">
          <text>{{item.title}}</text>
          <text>{{item.balanceText}}</text>
        </view>
        <view class="record-row sub">
          <text>账户流水</text>
          <text>{{item.timeText}}</text>
        </view>
      </view>
    </view>

    <button wx:elif="{{recordsStatusText && !recordsLoginRequired}}" class="empty-state" bindtap="syncRecords">{{recordsStatusText}}</button>
    <view wx:elif="{{recordsLoginRequired}}" class="empty-state">{{recordsStatusText}}</view>
    <view wx:else class="empty-state">暂无资金记录</view>
    <button wx:if="{{recordsLoginRequired}}" class="ledger-more" bindtap="loginAndSyncRecords" loading="{{loginPending}}" disabled="{{loginPending}}">微信登录并重新同步流水</button>
    <button wx:elif="{{hasMore && !loading}}" class="ledger-more" bindtap="loadMoreRecords" loading="{{loadingMore}}" disabled="{{loadingMore}}">{{loadingMore ? '正在加载' : moreError || '加载更多流水'}}</button>
    <view wx:elif="{{records.length && !loading}}" class="empty-state">已显示全部流水</view>
    </view>
  </view>
</view>
