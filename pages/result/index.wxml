<view class="paper-bg result-page scene-theme-{{stageThemeKey}}" style="{{stageThemeStyle}}">
  <image class="global-bg-image" src="https://xcx.ukb88.com/assets/bg/bg.png" mode="scaleToFill"></image>

  <view class="app-header" style="padding-top: {{nav.statusBarHeight}}px; padding-right: {{nav.capsuleSpace}}px;">
    <view class="app-user" bindtap="onTapProfile" hover-class="clickable-hover">
      <image wx:if="{{userProfile.avatarUrl}}" class="app-user-avatar" src="{{userProfile.avatarUrl}}" mode="aspectFill"></image>
      <image wx:else class="app-user-avatar" src="{{defaultAvatar}}" mode="aspectFill"></image>
      <text class="app-user-name">{{userProfile.nickName}}</text>
    </view>
    <view class="app-header-right">
      <view class="app-status-pill">
        <text class="app-status-dot">●</text>
        <text class="app-status-text">{{modeText}}</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <view class="scene-backdrop theme-page-backdrop result-scene-backdrop" wx:if="{{stageImage}}">
      <image class="scene-backdrop-image" src="{{stageImage}}" mode="aspectFill"></image>
      <view class="scene-template"></view>
      <view class="scene-backdrop-mask"></view>
    </view>

    <view class="scene-layer result-scene-layer">
      <view class="result-hero">
        <view class="main-title {{selfRank ? 'personal-rank-title' : ''}}">{{selfRank ? '你获得第 ' + selfRank + ' 名' : resultTitle}}</view>
        <view class="sub-title">{{interrupted ? resultReason : totalText + ' · 点击玩家查看本局表现'}}</view>
      </view>

      <view class="crown-mark" wx:if="{{!interrupted}}">♛</view>
      <view class="podium-wrap" wx:if="{{!interrupted}}">
        <view class="podium side left {{top3.second.isSelf ? 'self-side' : ''}}" bindtap="onTapPlayer" data-player="{{top3.second}}" hover-class="clickable-hover">
          <image class="podium-avatar" src="{{top3.second.avatar}}" mode="aspectFill"></image>
          <text class="podium-rank silver">2</text>
          <view class="podium-name">{{top3.second.isSelf ? '我 · ' : ''}}{{top3.second.name}}</view>
          <view class="podium-score">{{top3.second.score}}</view>
        </view>

        <view class="podium winner {{top3.first.isSelf ? 'self-winner' : ''}}" bindtap="onTapPlayer" data-player="{{top3.first}}" hover-class="clickable-hover">
          <view class="winner-badge">♕</view>
          <image class="podium-avatar champion" src="{{top3.first.avatar}}" mode="aspectFill"></image>
          <text class="podium-rank gold">1</text>
          <view class="podium-name self">{{top3.first.isSelf ? '我 · ' : ''}}{{top3.first.name}}</view>
          <view class="podium-score self">{{top3.first.score}}</view>
        </view>

        <view class="podium side right {{top3.third.isSelf ? 'self-side' : ''}}" bindtap="onTapPlayer" data-player="{{top3.third}}" hover-class="clickable-hover">
          <image class="podium-avatar third" src="{{top3.third.avatar}}" mode="aspectFill"></image>
          <text class="podium-rank bronze">3</text>
          <view class="podium-name">{{top3.third.isSelf ? '我 · ' : ''}}{{top3.third.name}}</view>
          <view class="podium-score">{{top3.third.score}}</view>
        </view>
      </view>
      <view wx:if="{{challengeComparison}}" class="performance-team">好友挑战 · {{challengeComparison.outcome}}<text> · 你 {{challengeComparison.selfScore}} 分 / 好友 {{challengeComparison.friendScore}} 分</text></view>

      <canvas type="2d" id="result-share-card" class="result-share-canvas" aria-hidden="true"></canvas>
      <view class="action-row">
        <button class="primary-btn action-btn" bindtap="replay" loading="{{replayPending}}" disabled="{{replayPending}}" hover-class="btn-hover">{{matchmaking ? '再匹配一局' : replayNewRoom ? '新建好友房' : '原房再来一局'}}</button>
        <button class="action-btn ghost-btn" bindtap="goHome" disabled="{{replayPending}}" hover-class="btn-hover">返回首页</button>
      </view>
      <button class="result-share-action" wx:if="{{!interrupted && resultId}}" open-type="share">{{canShareChallenge ? '分享战绩 · 邀好友挑战' : '分享本局战绩'}}</button>
      <view class="performance-team" role="alert" wx:if="{{replayError}}">{{replayError}}</view>
      <view class="performance-team" wx:else>{{matchmaking ? '再匹配一局，保留景区并重新寻找对手。' : '续玩保留原房好友和景区，点击即准备，由房主开始下一局。'}}</view>
      <view class="next-growth-goal" wx:if="{{growthGoal && !interrupted}}">
        <text class="growth-goal-text">{{growthGoal.text}}</text>
        <button class="growth-goal-action" bindtap="openGrowthGoal" hover-class="btn-hover">{{growthGoal.actionLabel}}</button>
      </view>
      <view class="next-growth-goal" wx:if="{{passport && !interrupted}}">
        <text class="growth-goal-text">景区护照 · {{passport.stampedCount}} / {{passport.stages.length}} 枚印章</text>
        <text class="growth-goal-text" wx:if="{{passport.newStamp}}">本局获得「{{passport.newStamp.name}}」首游印章</text>
        <text class="growth-goal-text" wx:if="{{passport.badge}}">已获得「全景区巡游」徽章</text>
        <button wx:if="{{passport.nextStage}}" class="growth-goal-action" bindtap="openPassportStage" disabled="{{replayPending}}" hover-class="btn-hover">下一站：{{passport.nextStage.name}}</button>
      </view>

      <view class="match-performance" wx:if="{{performance}}">
        <view class="performance-title">{{performance.title}}</view>
        <view class="performance-message">{{performance.text}}</view>
        <view class="performance-counts">
          <text>福袋 {{performance.bags}}</text><text>礼物 {{performance.gifts}}</text><text>踩雷 {{performance.bombs}}</text>
        </view>
        <view class="performance-team">队友为你带来 +{{performance.received}} 分 · 你为队友带来 +{{performance.contributed}} 分<text wx:if="{{performance.causedLoss}}"> · 你的踩雷让队友扣 {{performance.causedLoss}} 分</text></view>
        <view class="performance-team">福袋 +10，礼物 +20，踩雷 −10；实际得分受联动和分数下限影响。</view>
      </view>

      <view class="settlement-panel" wx:if="{{!interrupted}}">
        <view class="income-block">
          <view class="meta-title">本局所得</view>
          <view class="income-main">
            <text class="currency-unit">锦鲤币</text>
            <text class="currency-amount">{{incomeAmountText}}</text>
          </view>
        </view>
        <view class="exp-module" wx:if="{{expProgress}}">
          <view class="exp-head">
            <text>Lv.{{expProgress.level}}</text>
            <text>+{{gainText}} EXP</text>
          </view>
          <view class="exp-track">
            <view class="exp-fill" style="width: {{expProgress.percent}}%;"></view>
          </view>
          <view class="exp-foot">{{expProgress.current}}/{{expProgress.required}}</view>
        </view>
        <view wx:else class="exp-module">
          <view class="exp-head">本局经验 +{{gainText}} EXP</view>
          <button wx:if="{{expError}}" bindtap="syncResultExperience">{{expError}}</button>
          <view wx:else class="exp-foot">正在同步账号经验…</view>
        </view>
        <view class="achievement-pill" style="--medal-accent: {{achievementMedal.accent}}; --medal-glow: {{achievementMedal.glow}}; --medal-rim: {{achievementMedal.rim}}; --medal-plate: {{achievementMedal.plate}};">
          <view class="achievement-medal">
            <view class="medal-ribbon left"></view>
            <view class="medal-ribbon right"></view>
            <view class="medal-core">
              <view class="medal-symbol">{{achievementMedal.symbol}}</view>
            </view>
          </view>
          <view class="achievement-copy">
            <view class="achievement-row">
              <text class="achievement-label">新成就</text>
              <text class="medal-tier">{{achievementMedal.tierLabel}} · {{achievementMedal.shortName}}</text>
            </view>
            <text class="achievement-name">{{achievementText}}</text>
          </view>
        </view>
      </view>

      <view class="rank-head" wx:if="{{!interrupted}}">
        <view class="rank-title">排名</view>
        <view class="rank-total">{{totalText}}</view>
      </view>

      <view class="rank-list" wx:if="{{!interrupted}}">
        <view class="rank-item {{item.isSelf ? 'is-self' : ''}}" wx:for="{{rankList}}" wx:key="rank" bindtap="onTapPlayer" data-player="{{item}}" hover-class="clickable-hover">
          <text class="rank">{{item.rank}}</text>
          <image class="avatar sm" src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="player">{{item.isSelf ? '我 · ' : ''}}{{item.name}}</text>
          <text class="num">{{item.score}}</text>
        </view>
      </view>

      <view class="bottom-nav result-nav {{navExpanded ? 'expanded' : 'collapsed'}}">
        <block wx:if="{{navExpanded}}">
          <view wx:for="{{ tabs }}" wx:key="key" class="nav-item {{ activeTab === item.key ? 'active' : '' }}" data-page="{{ item.page }}" bindtap="switchTab" hover-class="clickable-hover">
            <view class="nav-dot">
              <image class="nav-icon" src="{{activeTab===item.key ? item.iconActive : item.icon}}" mode="aspectFit"></image>
            </view>
            <text>{{ item.label }}</text>
          </view>
        </block>
        <view class="nav-toggle" catchtap="toggleNav" hover-class="clickable-hover" aria-role="button" aria-label="{{navExpanded ? '收起导航' : '展开导航'}}"><view class="nav-toggle-arrow"></view></view>
      </view>

      <view class="nav-placeholder"></view>
    </view>

    <view class="guide-overlay guide-result" wx:if="{{guideVisible}}">
      <view class="guide-mask"></view>
      <view class="guide-card guide-card-middle">
        <view class="guide-kicker">新手引导 5/5</view>
        <view class="guide-title">查看本局锦鲤币、排行和经验，再邀请好友来一局。</view>
      </view>
      <view class="guide-action-panel">
        <button class="guide-primary" bindtap="finishGuide" hover-class="btn-hover">知道了</button>
      </view>
    </view>
  </view>

  <!-- 烟花特效容器 -->
  <view class="fireworks-container" wx:if="{{showFireworks}}">
    <view class="firework" wx:for="{{fireworkParticles}}" wx:key="id" style="left: {{item.left}}rpx; top: {{item.top}}rpx; animation-delay: {{item.delay}}ms;">
      <view class="firework-particle" wx:for="{{item.particles}}" wx:key="index" style="--angle: {{item.angle}}deg; --color: {{item.color}}; --size: {{item.size}}rpx; animation-delay: {{item.pDelay}}ms;"></view>
    </view>
  </view>

  <!-- 锦鲤揭晓特效 -->
  <view class="koi-effect-layer" wx:if="{{showKoiEffect}}">
    <view class="koi-effect-mask" bindtap="closeKoiEffect"></view>
    <view class="koi-blessing" wx:for="{{koiBlessings}}" wx:key="id" style="left: {{item.left}}rpx; animation-delay: {{item.delay}}ms;">
      <text>{{item.label}}</text>
    </view>
    <view class="koi-reveal-card">
      <view class="koi-aura"></view>
      <view class="koi-fish koi-fish-left"></view>
      <view class="koi-fish koi-fish-right"></view>
      <view class="koi-card-inner">
        <view class="koi-card-shine"></view>
        <view class="koi-eyebrow">本局天选</view>
        <view class="koi-medallion">
          <view class="koi-medallion-ring"></view>
          <view class="koi-medallion-core">锦</view>
        </view>
        <view class="koi-title">你是锦鲤</view>
        <view class="koi-copy">好运已到账</view>
        <view class="koi-caption">第 1 名专属奖励</view>
        <button wx:if="{{koiCtaVisible}}" class="koi-accept-btn" bindtap="closeKoiEffect" hover-class="btn-hover">收下好运</button>
      </view>
    </view>
  </view>

  <!-- 玩家分数明细弹窗 -->
  <view class="score-popup" wx:if="{{showScorePopup}}">
    <view class="score-popup-mask" bindtap="closeScorePopup"></view>
    <view class="score-popup-content">
      <view class="score-popup-close" bindtap="closeScorePopup">✕</view>
      <view class="score-popup-header">
        <image class="score-popup-avatar" src="{{selectedPlayer.avatar}}" mode="aspectFill"></image>
        <view class="score-popup-name">{{selectedPlayer.name}}</view>
        <view class="score-popup-total">总分 <text class="highlight">{{selectedPlayer.score}}</text></view>
      </view>
      <view class="score-popup-body" wx:if="{{selectedPerformance}}">
        <view class="score-item"><text class="score-label">福袋 / 礼物 / 踩雷</text><text class="score-value">{{selectedPerformance.bags}} / {{selectedPerformance.gifts}} / {{selectedPerformance.bombs}}</text></view>
        <view class="score-item"><text class="score-label">队友带来的分数</text><text class="score-value">+{{selectedPerformance.received}}</text></view>
        <view class="score-item"><text class="score-label">给队友带来的分数</text><text class="score-value">+{{selectedPerformance.contributed}}</text></view>
        <view class="score-item"><text class="score-label">踩雷导致队友扣分</text><text class="score-value">−{{selectedPerformance.causedLoss}}</text></view>
        <view wx:if="{{!selectedPerformance.complete}}">仅显示恢复后记录的表现</view>
      </view>
      <view class="score-popup-body" wx:elif="{{hasScoreBreakdown}}">
        <view class="score-item">
          <text class="score-label">回合得分</text>
          <text class="score-value">{{scoreBreakdown.round}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">团队联动</text>
          <text class="score-value">{{scoreBreakdown.teamBonus}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">福袋加成</text>
          <text class="score-value">{{scoreBreakdown.investment}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">福袋事件</text>
          <text class="score-value">{{scoreBreakdown.fortuneBag}}</text>
        </view>
      </view>
      <view class="score-popup-body" wx:else>本局没有可用的得分明细</view>
      <view class="score-popup-divider"></view>
      <view class="score-popup-footer">
        总分以最终排名为准
      </view>
    </view>
  </view>
</view>
